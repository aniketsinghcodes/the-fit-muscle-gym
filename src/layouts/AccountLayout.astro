---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "My Account | THE FIT MUSCLE GYM" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#080808" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body class="bg-[#080808] text-[#F5F2EA] min-h-screen flex flex-col font-['DM_Sans'] antialiased selection:bg-[#C9B27C]/30 selection:text-[#F5F2EA]">
    <!-- Member Header -->
    <header class="sticky top-0 z-40 bg-[#080808]/95 backdrop-blur-md border-b border-[#1E1E1E]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between">
        <!-- Logo / Brand -->
        <a href="/" class="flex items-center gap-3 group" title="Return to public website">
          <div class="w-9 h-9 rounded-lg bg-[#171717] border border-[#C9B27C]/40 flex items-center justify-center text-[#C9B27C] font-bold group-hover:border-[#C9B27C] transition-colors">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 5.57 4.14 4.14 2.71 2.71 4.14l1.43 1.43L2 7.71l1.43 1.43L2 10.57 3.43 12 7 8.43 15.57 17 12 20.57 13.43 22l1.43-1.43 1.43 1.43 2.14-2.14 1.43 1.43 1.43-1.43-1.43-1.43 1.43-1.43-1.43-1.43 1.43-1.43zM5.57 7L7 5.57l8.43 8.43-1.43 1.43L5.57 7z" />
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="font-['Oswald'] text-lg font-bold tracking-wider text-[#F5F2EA] leading-tight">
              THE FIT MUSCLE GYM
            </span>
            <span class="text-[10px] uppercase tracking-widest text-[#C9B27C] font-semibold">
              MEMBER PORTAL
            </span>
          </div>
        </a>

        <!-- Member Navigation Links -->
        <nav class="hidden md:flex items-center gap-6" aria-label="Member Navigation">
          <a
            href="/account"
            class="text-sm font-medium text-[#A7A29A] hover:text-[#C9B27C] transition-colors py-1 border-b-2 border-transparent hover:border-[#C9B27C]"
            id="nav-account"
          >
            Dashboard
          </a>
          <a
            href="/account/attendance"
            class="text-sm font-medium text-[#A7A29A] hover:text-[#C9B27C] transition-colors py-1 border-b-2 border-transparent hover:border-[#C9B27C]"
            id="nav-attendance"
          >
            Attendance Log
          </a>
          <a
            href="/"
            class="text-xs uppercase tracking-wider text-[#7A756D] hover:text-[#A7A29A] transition-colors"
          >
            Public Site &rarr;
          </a>
        </nav>

        <!-- Member Controls & Sign Out -->
        <div class="flex items-center gap-3">
          <div class="hidden sm:flex flex-col text-right">
            <span id="user-display-name" class="text-xs font-semibold text-[#F5F2EA] truncate max-w-[140px]">
              Loading...
            </span>
            <span id="user-display-phone" class="text-[10px] text-[#A7A29A]">
              Member
            </span>
          </div>

          <button
            type="button"
            id="account-signout-btn"
            class="px-3 py-1.5 rounded-lg bg-[#171717] border border-[#2E2E2E] text-xs font-semibold text-[#A7A29A] hover:text-[#E53E3E] hover:border-[#E53E3E]/40 transition-all cursor-pointer"
            title="Sign out of your account"
          >
            Sign Out
          </button>
        </div>
      </div>

      <!-- Mobile Sub-navigation Bar -->
      <div class="md:hidden border-t border-[#171717] px-4 py-2 flex items-center justify-around text-xs bg-[#111111]">
        <a href="/account" class="py-1 text-[#A7A29A] hover:text-[#C9B27C] font-medium" id="mobile-nav-account">
          Dashboard
        </a>
        <a href="/account/attendance" class="py-1 text-[#A7A29A] hover:text-[#C9B27C] font-medium" id="mobile-nav-attendance">
          Attendance
        </a>
        <a href="/" class="py-1 text-[#7A756D] hover:text-[#A7A29A]">
          Public Site
        </a>
      </div>
    </header>

    <!-- Main Portal Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[#171717] py-6 text-center text-xs text-[#7A756D]">
      <p>THE FIT MUSCLE GYM &bull; Mishri Lal Chauraha, Dabauli West, Kanpur</p>
    </footer>

    <!-- Client-side Member Auth Guard -->
    <script>
      import { getCurrentSession, getCurrentProfile, signOut } from '../lib/supabase';

      async function checkMemberAuth() {
        const { session } = await getCurrentSession();
        if (!session?.user) {
          window.location.href = '/login';
          return;
        }

        const profile = await getCurrentProfile();
        const nameEl = document.getElementById('user-display-name');
        const phoneEl = document.getElementById('user-display-phone');

        if (nameEl) {
          nameEl.textContent = profile?.full_name || 'Member';
        }
        if (phoneEl) {
          phoneEl.textContent = profile?.phone || session.user.phone || '';
        }

        // Highlight active nav tab
        const currentPath = window.location.pathname;
        if (currentPath.includes('/account/attendance')) {
          document.getElementById('nav-attendance')?.classList.add('text-[#C9B27C]', 'border-[#C9B27C]');
          document.getElementById('mobile-nav-attendance')?.classList.add('text-[#C9B27C]', 'font-bold');
        } else {
          document.getElementById('nav-account')?.classList.add('text-[#C9B27C]', 'border-[#C9B27C]');
          document.getElementById('mobile-nav-account')?.classList.add('text-[#C9B27C]', 'font-bold');
        }
      }

      document.getElementById('account-signout-btn')?.addEventListener('click', async () => {
        await signOut();
        window.location.href = '/login';
      });

      checkMemberAuth();
    </script>
  </body>
</html>
