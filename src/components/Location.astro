---
import { site } from "../data/site";
---

<section id="location" class="py-20 lg:py-28 bg-[#111111] border-b border-[#171717]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block text-xs uppercase font-semibold tracking-widest text-[#C9B27C] mb-3">
        FIND OUR GYM
      </span>
      <h2 class="font-['Oswald'] text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#F5F2EA] uppercase">
        LOCATION & HOURS
      </h2>
      <div class="w-16 h-1 bg-[#C9B27C] mx-auto mt-4 rounded-full"></div>
      <p class="font-['DM_Sans'] text-base sm:text-lg text-[#A7A29A] mt-5">
        Conveniently situated in Dabauli West with dedicated morning and evening training hours.
      </p>
    </div>

    <!-- Location & Timing Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <!-- Address & Info Box -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-6">
        <!-- Physical Location -->
        <div class="bg-[#171717] rounded-2xl border border-[#262626] p-7 shadow-xl">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-[#111111] border border-[#C9B27C]/30 flex items-center justify-center text-[#C9B27C] shrink-0 mt-1">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-['Oswald'] text-xl font-bold text-[#F5F2EA] uppercase tracking-wide">
                GYM ADDRESS
              </h3>
              <p class="font-['DM_Sans'] text-sm sm:text-base text-[#A7A29A] mt-2 leading-relaxed">
                Mishri Lal Chauraha, Dabauli West, Kanpur, Uttar Pradesh 208022, India
              </p>
              <div class="mt-4">
                <a
                  href={site.mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-['Oswald'] text-xs font-bold uppercase tracking-wider bg-[#C9B27C] text-[#080808] hover:bg-[#D8C28E] transition-colors shadow-md"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                  <span>GET DIRECTIONS</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Opening Hours Box -->
        <div class="bg-[#171717] rounded-2xl border border-[#262626] p-7 shadow-xl">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-[#111111] border border-[#C9B27C]/30 flex items-center justify-center text-[#C9B27C] shrink-0 mt-1">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="w-full">
              <h3 class="font-['Oswald'] text-xl font-bold text-[#F5F2EA] uppercase tracking-wide">
                OPENING HOURS
              </h3>

              <div class="mt-4 space-y-3 font-['DM_Sans'] text-sm">
                <!-- Morning Batch -->
                <div class="flex justify-between items-center py-2 border-b border-[#222222]">
                  <span class="text-[#F5F2EA] font-medium">Monday – Saturday (Morning)</span>
                  <span class="font-['Oswald'] font-bold text-[#C9B27C] tracking-wide">5:30 AM – 10:00 AM</span>
                </div>

                <!-- Evening Batch -->
                <div class="flex justify-between items-center py-2 border-b border-[#222222]">
                  <span class="text-[#F5F2EA] font-medium">Monday – Saturday (Evening)</span>
                  <span class="font-['Oswald'] font-bold text-[#C9B27C] tracking-wide">5:00 PM – 10:00 PM</span>
                </div>

                <!-- Sunday -->
                <div class="flex justify-between items-center py-2 text-[#A7A29A]">
                  <span>Sunday</span>
                  <span class="font-['Oswald'] uppercase tracking-wider text-xs px-2.5 py-0.5 rounded bg-[#262626] text-[#A7A29A]">Closed</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Google Maps Embed / Interactive Preview -->
      <div class="lg:col-span-7 rounded-2xl overflow-hidden border border-[#262626] bg-[#171717] min-h-[380px] shadow-xl relative flex flex-col">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3572.7661596700547!2d80.3012028!3d26.4385172!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x399c4709d784cf8f%3A0xb36fceae65e2361d!2sTHE%20FIT%20MUSCLE%20GYM!5e0!3m2!1sen!2sin!4v1710000000000!5m2!1sen!2sin"
          width="100%"
          height="100%"
          style="border:0; min-height: 380px;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="THE FIT MUSCLE GYM Google Maps Location"
          class="w-full h-full filter invert-[0.9] hue-rotate-180 contrast-125 brightness-90"
        ></iframe>

        <!-- Map Footer Bar -->
        <div class="p-4 bg-[#171717] border-t border-[#222222] flex items-center justify-between">
          <span class="text-xs text-[#A7A29A] font-['DM_Sans']">
            THE FIT MUSCLE GYM • Dabauli West, Kanpur
          </span>
          <a
            href={site.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-['Oswald'] text-[#C9B27C] hover:text-[#D8C28E] uppercase tracking-wider flex items-center gap-1"
          >
            <span>Open in Google Maps App</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
