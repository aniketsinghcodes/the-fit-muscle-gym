---
import { site } from "../data/site";
---

<section id="trainer" class="py-20 lg:py-28 bg-[#111111] border-b border-[#171717]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block text-xs uppercase font-semibold tracking-widest text-[#C9B27C] mb-3">
        EXPERT COACHING
      </span>
      <h2 class="font-['Oswald'] text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#F5F2EA] uppercase">
        MEET THE TRAINER
      </h2>
      <div class="w-16 h-1 bg-[#C9B27C] mx-auto mt-4 rounded-full"></div>
      <p class="font-['DM_Sans'] text-base sm:text-lg text-[#A7A29A] mt-5">
        Personal guidance, proper form, and steady motivation from our resident fitness coach.
      </p>
    </div>

    <!-- Trainer Card (Single Featured Real Trainer) -->
    <div class="max-w-4xl mx-auto bg-[#171717] rounded-3xl border border-[#2E2E2E] overflow-hidden shadow-2xl">
      <div class="grid grid-cols-1 md:grid-cols-12 items-stretch">
        <!-- Trainer Real Photo -->
        <div class="md:col-span-5 relative min-h-[380px] bg-[#080808]">
          <img
            src={site.trainer.image}
            alt="Krishna Gupta - Gym Trainer at The Fit Muscle Gym"
            class="w-full h-full object-cover object-top"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#171717] via-transparent to-transparent md:hidden"></div>
          <div class="absolute top-4 left-4 px-3 py-1 rounded-full bg-[#080808]/80 backdrop-blur-md border border-[#C9B27C]/40 text-xs font-['Oswald'] tracking-wider text-[#C9B27C] uppercase">
            CERTIFIED TRAINER
          </div>
        </div>

        <!-- Trainer Information -->
        <div class="md:col-span-7 p-6 sm:p-10 flex flex-col justify-between">
          <div class="space-y-4">
            <div>
              <span class="text-xs uppercase font-['DM_Sans'] font-semibold tracking-widest text-[#C9B27C]">
                {site.trainer.role}
              </span>
              <h3 class="font-['Oswald'] text-3xl sm:text-4xl font-bold text-[#F5F2EA] uppercase mt-1">
                {site.trainer.name}
              </h3>
              <div class="inline-flex items-center gap-2 mt-2 px-3 py-1 rounded-lg bg-[#111111] border border-[#2A2A2A] text-xs font-['DM_Sans'] text-[#C9B27C]">
                <svg class="w-4 h-4 text-[#C9B27C]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="font-semibold">{site.trainer.experience}</span>
              </div>
            </div>

            <p class="font-['DM_Sans'] text-sm sm:text-base text-[#A7A29A] leading-relaxed">
              With 5 years of dedicated fitness training experience, Krishna Gupta oversees workout routines, helps members master lift mechanics safely, and keeps everyone motivated to push their limits.
            </p>

            <!-- Focus Areas -->
            <div class="pt-2">
              <h4 class="text-xs uppercase font-['Oswald'] tracking-wider text-[#F5F2EA] mb-2">Training Focus</h4>
              <div class="flex flex-wrap gap-2">
                <span class="px-3 py-1 rounded-full bg-[#111111] text-xs text-[#F5F2EA] border border-[#2A2A2A]">
                  Strength & Hypertrophy
                </span>
                <span class="px-3 py-1 rounded-full bg-[#111111] text-xs text-[#F5F2EA] border border-[#2A2A2A]">
                  Safe Technique & Posture
                </span>
                <span class="px-3 py-1 rounded-full bg-[#111111] text-xs text-[#F5F2EA] border border-[#2A2A2A]">
                  Fat Loss & Conditioning
                </span>
                <span class="px-3 py-1 rounded-full bg-[#111111] text-xs text-[#F5F2EA] border border-[#2A2A2A]">
                  Beginner Guidance
                </span>
              </div>
            </div>
          </div>

          <!-- Working Trainer Social Links -->
          <div class="pt-8 mt-6 border-t border-[#262626] flex flex-wrap items-center gap-4">
            <a
              href={site.trainer.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-xl bg-[#111111] border border-[#2E2E2E] text-xs sm:text-sm font-medium text-[#F5F2EA] hover:text-[#C9B27C] hover:border-[#C9B27C]/50 transition-all cursor-pointer group"
              aria-label="Visit Krishna Gupta's Instagram profile @fit_crox"
            >
              <svg class="w-4 h-4 text-[#C9B27C] group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span>@fit_crox</span>
            </a>

            <a
              href={site.trainer.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-xl bg-[#C9B27C] text-[#080808] text-xs sm:text-sm font-bold font-['Oswald'] tracking-wider hover:bg-[#D8C28E] transition-all cursor-pointer shadow-md"
              aria-label="Chat directly with Krishna Gupta on WhatsApp"
            >
              <svg class="w-4 h-4 text-[#080808]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"></path>
                <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"></path>
              </svg>
              <span>CHAT ON WHATSAPP</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
