---
import { site, navLinks } from "../data/site";
---

<div
  id="mobile-menu-drawer"
  class="fixed inset-0 z-50 lg:hidden pointer-events-none transition-opacity duration-300 opacity-0"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation Menu"
>
  <!-- Backdrop -->
  <div
    id="mobile-backdrop"
    class="absolute inset-0 bg-black/80 backdrop-blur-sm transition-opacity"
  ></div>

  <!-- Drawer Panel -->
  <div
    id="mobile-drawer-panel"
    class="absolute top-0 right-0 w-[85%] max-w-sm h-full bg-[#111111] border-l border-[#171717] shadow-2xl flex flex-col justify-between p-6 transform translate-x-full transition-transform duration-300 ease-out overflow-y-auto"
  >
    <!-- Top Bar in Drawer -->
    <div>
      <div class="flex items-center justify-between pb-6 border-b border-[#171717]">
        <div class="flex items-center gap-2">
          <span class="font-['Oswald'] text-lg font-bold tracking-wider text-[#F5F2EA]">
            THE FIT MUSCLE GYM
          </span>
        </div>
        <button
          type="button"
          id="close-drawer-btn"
          class="p-2 rounded-lg text-[#A7A29A] hover:text-[#F5F2EA] hover:bg-[#171717] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#C9B27C] cursor-pointer"
          aria-label="Close menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Nav Links -->
      <nav class="flex flex-col gap-1 mt-6" aria-label="Mobile Links">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link text-base font-medium py-3 px-3 rounded-lg text-[#F5F2EA] hover:text-[#C9B27C] hover:bg-[#171717] transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Drawer Footer Actions -->
    <div class="pt-6 border-t border-[#171717] flex flex-col gap-4">
      <button
        type="button"
        data-open-enquiry
        class="w-full py-3.5 px-6 rounded-xl font-['Oswald'] tracking-wider text-base font-bold uppercase bg-[#C9B27C] text-[#080808] hover:bg-[#D8C28E] transition-colors text-center cursor-pointer shadow-lg active:scale-95"
      >
        JOIN NOW
      </button>

      <!-- Quick Gym Info Summary -->
      <div class="text-xs text-[#A7A29A] space-y-1 text-center">
        <p class="font-medium text-[#F5F2EA]">Mishri Lal Chauraha, Dabauli West</p>
        <p>Mon–Sat: 5:30 AM–10:00 AM | 5:00 PM–10:00 PM</p>
      </div>
    </div>
  </div>
</div>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById("mobile-menu-btn");
    const drawer = document.getElementById("mobile-menu-drawer");
    const panel = document.getElementById("mobile-drawer-panel");
    const backdrop = document.getElementById("mobile-backdrop");
    const closeBtn = document.getElementById("close-drawer-btn");
    const hamburgerIcon = document.getElementById("hamburger-icon");
    const closeIcon = document.getElementById("close-icon");
    const links = document.querySelectorAll(".mobile-nav-link");

    if (!btn || !drawer || !panel || !backdrop) return;

    let isOpen = false;

    function openMenu() {
      isOpen = true;
      btn?.setAttribute("aria-expanded", "true");
      drawer?.classList.remove("pointer-events-none", "opacity-0");
      drawer?.classList.add("opacity-100");
      panel?.classList.remove("translate-x-full");
      panel?.classList.add("translate-x-0");
      hamburgerIcon?.classList.add("hidden");
      closeIcon?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      closeBtn?.focus();
    }

    function closeMenu() {
      isOpen = false;
      btn?.setAttribute("aria-expanded", "false");
      drawer?.classList.add("opacity-0");
      drawer?.classList.remove("opacity-100");
      panel?.classList.add("translate-x-full");
      panel?.classList.remove("translate-x-0");
      hamburgerIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
      document.body.style.overflow = "";
      setTimeout(() => {
        if (!isOpen) drawer?.classList.add("pointer-events-none");
      }, 300);
      btn?.focus();
    }

    btn.addEventListener("click", () => {
      if (isOpen) closeMenu();
      else openMenu();
    });

    closeBtn?.addEventListener("click", closeMenu);
    backdrop?.addEventListener("click", closeMenu);

    links.forEach((l) => {
      l.addEventListener("click", () => {
        closeMenu();
      });
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) {
        closeMenu();
      }
    });
  }

  setupMobileMenu();
  document.addEventListener("astro:page-load", setupMobileMenu);
</script>
