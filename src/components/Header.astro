---
import { site, navLinks } from "../data/site";
---

<header
  id="site-header"
  class="sticky top-0 z-40 w-full bg-[#080808]/90 backdrop-blur-md border-b border-[#171717] transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Gym Wordmark / Logo -->
    <a
      href="#"
      class="group flex items-center gap-3 focus-visible:outline-2 focus-visible:outline-[#C9B27C] rounded py-1 px-2 -ml-2 transition-transform"
      aria-label="THE FIT MUSCLE GYM Home"
    >
      <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-[#171717] to-[#111111] border border-[#C9B27C]/40 flex items-center justify-center text-[#C9B27C] font-bold group-hover:border-[#C9B27C] transition-colors shadow-inner">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 5.57 4.14 4.14 2.71 2.71 4.14l1.43 1.43L2 7.71l1.43 1.43L2 10.57 3.43 12 7 8.43 15.57 17 12 20.57 13.43 22l1.43-1.43 1.43 1.43 2.14-2.14 1.43 1.43 1.43-1.43-1.43-1.43 1.43-1.43-1.43-1.43 1.43-1.43zM5.57 7L7 5.57l8.43 8.43-1.43 1.43L5.57 7z" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-['Oswald'] text-xl sm:text-2xl font-bold tracking-wider text-[#F5F2EA] group-hover:text-[#C9B27C] transition-colors leading-none">
          THE FIT MUSCLE GYM
        </span>
        <span class="text-[10px] uppercase font-['DM_Sans'] tracking-widest text-[#A7A29A] mt-1">
          Dabauli West, Kanpur
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-7" aria-label="Main Navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium tracking-wide text-[#A7A29A] hover:text-[#C9B27C] transition-colors duration-200 py-1 border-b-2 border-transparent hover:border-[#C9B27C]/50"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Header Actions (Desktop) -->
    <div class="hidden lg:flex items-center gap-4">
      <button
        type="button"
        data-open-enquiry
        class="inline-flex items-center justify-center px-6 py-2.5 rounded-full font-['Oswald'] tracking-wider text-sm font-semibold uppercase bg-[#C9B27C] text-[#080808] hover:bg-[#D8C28E] hover:shadow-[0_0_20px_rgba(201,178,124,0.3)] transition-all duration-300 cursor-pointer active:scale-95"
      >
        JOIN NOW
      </button>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <button
      type="button"
      id="mobile-menu-btn"
      class="lg:hidden p-2 rounded-lg text-[#F5F2EA] hover:text-[#C9B27C] hover:bg-[#171717] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#C9B27C] transition-colors cursor-pointer"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu-drawer"
    >
      <svg id="hamburger-icon" class="w-7 h-7 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="w-7 h-7 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</header>
