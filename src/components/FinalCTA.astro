---
import { site } from "../data/site";
---

<section id="contact" class="py-20 lg:py-28 bg-[#080808] border-b border-[#171717] relative overflow-hidden">
  <!-- Subtle Ambient Glow -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-[#C9B27C]/10 via-transparent to-transparent pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <span class="inline-block text-xs uppercase font-semibold tracking-widest text-[#C9B27C] mb-3">
      START YOUR TRANSFORMATION
    </span>
    
    <h2 class="font-['Oswald'] text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-[#F5F2EA] uppercase max-w-3xl mx-auto leading-tight">
      READY TO BUILD YOUR STRONGEST SELF?
    </h2>

    <p class="font-['DM_Sans'] text-base sm:text-lg text-[#A7A29A] max-w-xl mx-auto mt-4 leading-relaxed">
      Visit us at Dabauli West or reach out directly. Krishna Gupta and the FIT MUSCLE community are ready to welcome you.
    </p>

    <!-- Main CTA Button -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
      <button
        type="button"
        data-open-enquiry
        class="w-full sm:w-auto px-10 py-4 rounded-xl font-['Oswald'] text-lg font-bold uppercase tracking-wider bg-[#C9B27C] text-[#080808] hover:bg-[#D8C28E] hover:shadow-[0_0_30px_rgba(201,178,124,0.35)] transition-all duration-300 cursor-pointer active:scale-95 shadow-xl"
      >
        JOIN NOW
      </button>

      <a
        href={site.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl font-['Oswald'] text-base font-bold uppercase tracking-wider bg-[#171717] text-[#F5F2EA] border border-[#2E2E2E] hover:border-[#C9B27C]/60 hover:bg-[#1E1E1E] transition-all duration-300 cursor-pointer shadow-lg"
      >
        <svg class="w-5 h-5 text-[#C9B27C]" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"></path>
          <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"></path>
        </svg>
        <span>CHAT ON WHATSAPP</span>
      </a>
    </div>

    <!-- Quick Contact Cards Strip (NO tel: URL, uses clipboard copy button!) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-12 max-w-3xl mx-auto">
      <!-- Phone / Copy Number -->
      <button
        type="button"
        data-action="copy-phone"
        class="p-5 rounded-2xl bg-[#111111] border border-[#222222] hover:border-[#C9B27C]/50 transition-all text-left flex items-center gap-4 cursor-pointer group"
        aria-label="Copy phone number +91 91406 61828 to clipboard"
      >
        <div class="w-10 h-10 rounded-xl bg-[#171717] border border-[#2E2E2E] group-hover:border-[#C9B27C]/40 flex items-center justify-center text-[#C9B27C] shrink-0 transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </div>
        <div class="overflow-hidden">
          <span class="text-[11px] font-['Oswald'] uppercase tracking-wider text-[#A7A29A] block">
            CALL NOW (CLICK TO COPY)
          </span>
          <span class="font-['Oswald'] text-base font-bold text-[#F5F2EA] group-hover:text-[#C9B27C] transition-colors truncate block">
            {site.phone}
          </span>
        </div>
      </button>

      <!-- Instagram -->
      <a
        href={site.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="p-5 rounded-2xl bg-[#111111] border border-[#222222] hover:border-[#C9B27C]/50 transition-all text-left flex items-center gap-4 group"
        aria-label="Visit Instagram page @the.fitmuscle"
      >
        <div class="w-10 h-10 rounded-xl bg-[#171717] border border-[#2E2E2E] group-hover:border-[#C9B27C]/40 flex items-center justify-center text-[#C9B27C] shrink-0 transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </div>
        <div class="overflow-hidden">
          <span class="text-[11px] font-['Oswald'] uppercase tracking-wider text-[#A7A29A] block">
            INSTAGRAM
          </span>
          <span class="font-['Oswald'] text-base font-bold text-[#F5F2EA] group-hover:text-[#C9B27C] transition-colors truncate block">
            @the.fitmuscle
          </span>
        </div>
      </a>

      <!-- Google Maps -->
      <a
        href={site.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="p-5 rounded-2xl bg-[#111111] border border-[#222222] hover:border-[#C9B27C]/50 transition-all text-left flex items-center gap-4 group"
        aria-label="Find gym on Google Maps"
      >
        <div class="w-10 h-10 rounded-xl bg-[#171717] border border-[#2E2E2E] group-hover:border-[#C9B27C]/40 flex items-center justify-center text-[#C9B27C] shrink-0 transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <div class="overflow-hidden">
          <span class="text-[11px] font-['Oswald'] uppercase tracking-wider text-[#A7A29A] block">
            LOCATION
          </span>
          <span class="font-['Oswald'] text-base font-bold text-[#F5F2EA] group-hover:text-[#C9B27C] transition-colors truncate block">
            Dabauli West
          </span>
        </div>
      </a>
    </div>
  </div>
</section>
