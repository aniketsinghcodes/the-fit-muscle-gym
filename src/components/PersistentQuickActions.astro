---
import { site } from "../data/site";
---

<!-- ========================================== -->
<!-- 1. DESKTOP FLOATING QUICK ACTIONS DOCK     -->
<!-- ========================================== -->
<aside
  id="desktop-quick-dock"
  class="hidden lg:flex fixed bottom-6 right-6 z-40 flex-col items-end gap-2.5"
  aria-label="Quick Actions"
>
  <!-- Floating Actions Container -->
  <div class="flex flex-col items-center gap-2 p-2 rounded-2xl bg-[#141414]/90 backdrop-blur-xl border border-[#2E2E2E] shadow-2xl">
    <!-- 1. WhatsApp -->
    <a
      href={site.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group relative w-11 h-11 rounded-xl bg-[#171717] hover:bg-[#25D366] text-[#A7A29A] hover:text-[#080808] border border-[#262626] hover:border-[#25D366] flex items-center justify-center transition-all duration-200 cursor-pointer focus-visible:outline-2 focus-visible:outline-[#25D366]"
      aria-label="Chat on WhatsApp (+91 91406 61828)"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"></path>
        <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"></path>
      </svg>
      <span class="absolute right-full mr-3 px-2.5 py-1 rounded bg-[#080808] border border-[#2E2E2E] text-xs font-['DM_Sans'] text-[#F5F2EA] whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-lg">
        WhatsApp
      </span>
    </a>

    <!-- 2. Call Now (Copies number to clipboard - NO tel: link!) -->
    <button
      type="button"
      data-action="copy-phone"
      class="group relative w-11 h-11 rounded-xl bg-[#171717] hover:bg-[#C9B27C] text-[#A7A29A] hover:text-[#080808] border border-[#262626] hover:border-[#C9B27C] flex items-center justify-center transition-all duration-200 cursor-pointer focus-visible:outline-2 focus-visible:outline-[#C9B27C]"
      aria-label="Copy phone number +91 91406 61828 to clipboard"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span class="absolute right-full mr-3 px-2.5 py-1 rounded bg-[#080808] border border-[#2E2E2E] text-xs font-['DM_Sans'] text-[#F5F2EA] whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-lg">
        Copy Phone Number
      </span>
    </button>

    <!-- 3. Join Now -->
    <button
      type="button"
      data-open-enquiry
      class="group relative w-11 h-11 rounded-xl bg-[#C9B27C] hover:bg-[#D8C28E] text-[#080808] flex items-center justify-center transition-all duration-200 cursor-pointer shadow-md focus-visible:outline-2 focus-visible:outline-[#C9B27C]"
      aria-label="Open membership enquiry form"
    >
      <svg class="w-5 h-5 font-bold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
      </svg>
      <span class="absolute right-full mr-3 px-2.5 py-1 rounded bg-[#080808] border border-[#2E2E2E] text-xs font-['DM_Sans'] text-[#F5F2EA] whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-lg">
        Join Now
      </span>
    </button>

    <!-- 4. Maps -->
    <a
      href={site.mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group relative w-11 h-11 rounded-xl bg-[#171717] hover:bg-[#C9B27C] text-[#A7A29A] hover:text-[#080808] border border-[#262626] hover:border-[#C9B27C] flex items-center justify-center transition-all duration-200 cursor-pointer focus-visible:outline-2 focus-visible:outline-[#C9B27C]"
      aria-label="Open gym directions in Google Maps"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <span class="absolute right-full mr-3 px-2.5 py-1 rounded bg-[#080808] border border-[#2E2E2E] text-xs font-['DM_Sans'] text-[#F5F2EA] whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-lg">
        Google Maps
      </span>
    </a>

    <!-- 5. Instagram -->
    <a
      href={site.instagramUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group relative w-11 h-11 rounded-xl bg-[#171717] hover:bg-[#E1306C] text-[#A7A29A] hover:text-white border border-[#262626] hover:border-[#E1306C] flex items-center justify-center transition-all duration-200 cursor-pointer focus-visible:outline-2 focus-visible:outline-[#E1306C]"
      aria-label="Open Instagram profile @the.fitmuscle"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
      </svg>
      <span class="absolute right-full mr-3 px-2.5 py-1 rounded bg-[#080808] border border-[#2E2E2E] text-xs font-['DM_Sans'] text-[#F5F2EA] whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-lg">
        Instagram
      </span>
    </a>
  </div>
</aside>

<!-- ============================================================== -->
<!-- 2. MOBILE FLOATING ACTIONS (Maps & Instagram above bottom bar)  -->
<!-- ============================================================== -->
<aside
  class="lg:hidden fixed bottom-20 right-4 z-30 flex flex-col items-end gap-2.5"
  aria-label="Secondary Mobile Quick Actions"
>
  <!-- Maps Floating Action -->
  <a
    href={site.mapsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="w-10 h-10 rounded-full bg-[#171717] border border-[#2E2E2E] text-[#C9B27C] flex items-center justify-center shadow-lg active:scale-95 transition-all"
    aria-label="Open Directions in Google Maps"
  >
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
    </svg>
  </a>

  <!-- Instagram Floating Action -->
  <a
    href={site.instagramUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="w-10 h-10 rounded-full bg-[#171717] border border-[#2E2E2E] text-[#C9B27C] flex items-center justify-center shadow-lg active:scale-95 transition-all"
    aria-label="Open Instagram @the.fitmuscle"
  >
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
    </svg>
  </a>
</aside>

<!-- ============================================================== -->
<!-- 3. MOBILE COMPACT BOTTOM ACTION BAR (WhatsApp, Call, Join)     -->
<!-- ============================================================== -->
<aside
  id="mobile-bottom-bar"
  class="lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-[#111111]/95 backdrop-blur-xl border-t border-[#1F1F1F] shadow-[0_-10px_25px_rgba(0,0,0,0.5)] px-3 py-2"
  style="padding-bottom: max(0.5rem, env(safe-area-inset-bottom));"
  aria-label="Mobile Bottom Action Bar"
>
  <div class="grid grid-cols-3 gap-2 max-w-md mx-auto">
    <!-- WhatsApp Action -->
    <a
      href={site.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-col items-center justify-center py-1.5 px-2 rounded-xl bg-[#171717] text-[#A7A29A] hover:text-[#25D366] active:bg-[#1E1E1E] transition-colors min-h-[46px]"
      aria-label="Direct WhatsApp chat"
    >
      <svg class="w-5 h-5 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"></path>
        <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"></path>
      </svg>
      <span class="text-[10px] font-['Oswald'] uppercase font-bold tracking-wider mt-1 text-[#F5F2EA]">
        WhatsApp
      </span>
    </a>

    <!-- Call Now (Clipboard copy - NO tel: link!) -->
    <button
      type="button"
      data-action="copy-phone"
      class="flex flex-col items-center justify-center py-1.5 px-2 rounded-xl bg-[#171717] text-[#A7A29A] hover:text-[#C9B27C] active:bg-[#1E1E1E] transition-colors min-h-[46px] cursor-pointer"
      aria-label="Copy phone number +91 91406 61828"
    >
      <svg class="w-5 h-5 text-[#C9B27C]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span class="text-[10px] font-['Oswald'] uppercase font-bold tracking-wider mt-1 text-[#F5F2EA]">
        Call Now
      </span>
    </button>

    <!-- Join Now Action -->
    <button
      type="button"
      data-open-enquiry
      class="flex flex-col items-center justify-center py-1.5 px-2 rounded-xl bg-[#C9B27C] text-[#080808] hover:bg-[#D8C28E] active:scale-95 transition-all min-h-[46px] font-bold cursor-pointer shadow-md"
      aria-label="Open membership enquiry modal"
    >
      <svg class="w-5 h-5 font-bold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
      </svg>
      <span class="text-[10px] font-['Oswald'] uppercase font-extrabold tracking-wider mt-1 text-[#080808]">
        Join Now
      </span>
    </button>
  </div>
</aside>

<!-- ========================================== -->
<!-- 4. TOAST NOTIFICATION FOR NUMBER COPIED    -->
<!-- ========================================== -->
<div
  id="copy-toast"
  class="fixed top-24 left-1/2 -translate-x-1/2 z-50 pointer-events-none transition-all duration-300 opacity-0 transform -translate-y-4"
  role="alert"
  aria-live="polite"
>
  <div class="px-5 py-3 rounded-full bg-[#171717] border border-[#C9B27C] text-[#F5F2EA] shadow-2xl flex items-center gap-3">
    <div class="w-6 h-6 rounded-full bg-[#C9B27C] text-[#080808] flex items-center justify-center font-bold">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <span class="font-['DM_Sans'] text-sm font-semibold">
      Number copied: <strong class="text-[#C9B27C]">+91 91406 61828</strong>
    </span>
  </div>
</div>

<script>
  function setupPersistentQuickActions() {
    const copyButtons = document.querySelectorAll('[data-action="copy-phone"]');
    const toast = document.getElementById("copy-toast");
    const phoneNumber = "+91 91406 61828";
    let toastTimeout: any;

    function showToast() {
      if (!toast) return;
      clearTimeout(toastTimeout);
      toast.classList.remove("opacity-0", "-translate-y-4");
      toast.classList.add("opacity-100", "translate-y-0");

      toastTimeout = setTimeout(() => {
        toast.classList.remove("opacity-100", "translate-y-0");
        toast.classList.add("opacity-0", "-translate-y-4");
      }, 3000);
    }

    copyButtons.forEach((btn) => {
      btn.addEventListener("click", async () => {
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(phoneNumber);
          } else {
            // Fallback for non-https or older environments
            const input = document.createElement("input");
            input.value = phoneNumber;
            document.body.appendChild(input);
            input.select();
            document.execCommand("copy");
            document.body.removeChild(input);
          }
          showToast();
        } catch (err) {
          console.warn("Clipboard copy failed, fallback:", err);
          showToast();
        }
      });
    });
  }

  setupPersistentQuickActions();
  document.addEventListener("astro:page-load", setupPersistentQuickActions);
</script>
