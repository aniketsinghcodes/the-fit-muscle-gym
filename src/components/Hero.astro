---
import { site } from "../data/site";
---

<section
  id="hero"
  class="relative min-h-[90vh] lg:min-h-[85vh] flex items-center justify-center overflow-hidden bg-[#080808] border-b border-[#171717]"
>
  <!-- Background Image with Multi-layer Dark Gradient Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/gallery/community-celebration.png"
      alt="The Fit Muscle Gym community and interior"
      class="w-full h-full object-cover object-center filter brightness-[0.28] contrast-[1.1] scale-105 transform motion-safe:transition-transform motion-safe:duration-10000 motion-safe:hover:scale-100"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#080808] via-[#080808]/85 to-[#080808]/70"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-[#C9B27C]/10 via-transparent to-transparent"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 text-center flex flex-col items-center">
    <!-- Gym Badge / Wordmark -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#171717]/80 border border-[#C9B27C]/30 mb-8 backdrop-blur-md">
      <span class="w-2 h-2 rounded-full bg-[#C9B27C] animate-pulse"></span>
      <span class="font-['DM_Sans'] text-xs sm:text-sm font-semibold tracking-widest uppercase text-[#C9B27C]">
        THE FIT MUSCLE GYM • DABAULI WEST, KANPUR
      </span>
    </div>

    <!-- Main Heading -->
    <h1 class="font-['Oswald'] text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight text-[#F5F2EA] leading-[0.95] max-w-4xl uppercase">
      HEALTH. STRENGTH. <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#F5F2EA] via-[#C9B27C] to-[#D8C28E]">
        TRANSFORMATION.
      </span>
    </h1>

    <!-- Hindi Tagline -->
    <p class="font-['DM_Sans'] text-xl sm:text-2xl md:text-3xl font-medium tracking-wide text-[#C9B27C] mt-6">
      स्वास्थ्य। शक्ति। परिवर्तन।
    </p>

    <!-- Supporting Copy -->
    <p class="font-['DM_Sans'] text-lg sm:text-xl text-[#A7A29A] max-w-2xl mt-4 leading-relaxed font-normal">
      “A healthier you starts here.”
    </p>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-5 mt-10 w-full sm:w-auto">
      <button
        type="button"
        data-open-enquiry
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl font-['Oswald'] tracking-wider text-base font-bold uppercase bg-[#C9B27C] text-[#080808] hover:bg-[#D8C28E] hover:shadow-[0_0_30px_rgba(201,178,124,0.35)] transition-all duration-300 cursor-pointer active:scale-95 group"
      >
        <span>START YOUR JOURNEY</span>
        <svg class="w-5 h-5 ml-2 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>

      <a
        href="#about"
        class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl font-['Oswald'] tracking-wider text-base font-bold uppercase bg-[#171717] text-[#F5F2EA] border border-[#2E2E2E] hover:border-[#C9B27C]/50 hover:bg-[#1F1F1F] transition-all duration-300 cursor-pointer"
      >
        EXPLORE FIT MUSCLE
      </a>
    </div>

    <!-- Quick Highlights Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-8 mt-16 pt-12 border-t border-[#171717] w-full max-w-4xl text-left">
      <div class="p-3">
        <div class="font-['Oswald'] text-2xl sm:text-3xl font-bold text-[#C9B27C]">5+ YEARS</div>
        <div class="text-xs sm:text-sm text-[#A7A29A] mt-0.5">Trainer Experience</div>
      </div>
      <div class="p-3">
        <div class="font-['Oswald'] text-2xl sm:text-3xl font-bold text-[#C9B27C]">₹600/MO</div>
        <div class="text-xs sm:text-sm text-[#A7A29A] mt-0.5">Plans Starting At</div>
      </div>
      <div class="p-3">
        <div class="font-['Oswald'] text-2xl sm:text-3xl font-bold text-[#C9B27C]">2 SHIFTS</div>
        <div class="text-xs sm:text-sm text-[#A7A29A] mt-0.5">Morning & Evening</div>
      </div>
      <div class="p-3">
        <div class="font-['Oswald'] text-2xl sm:text-3xl font-bold text-[#C9B27C]">100% REAL</div>
        <div class="text-xs sm:text-sm text-[#A7A29A] mt-0.5">Community & Results</div>
      </div>
    </div>
  </div>
</section>
