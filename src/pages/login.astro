---
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#080808" />
    <title>Member Login | THE FIT MUSCLE GYM</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body class="bg-[#080808] text-[#F5F2EA] min-h-screen flex flex-col justify-between font-['DM_Sans'] antialiased selection:bg-[#C9B27C]/30 selection:text-[#F5F2EA]">
    <!-- Top Bar -->
    <header class="p-4 sm:p-6 flex items-center justify-between max-w-5xl mx-auto w-full">
      <a href="/" class="flex items-center gap-2 text-xs uppercase tracking-widest text-[#A7A29A] hover:text-[#C9B27C] transition-colors">
        &larr; Back to Public Website
      </a>
    </header>

    <!-- Main Auth Card Container -->
    <main class="flex-1 flex items-center justify-center p-4 sm:p-6">
      <div class="w-full max-w-md bg-[#141414] border border-[#242424] rounded-3xl p-7 sm:p-9 shadow-2xl relative overflow-hidden">
        <!-- Subtle Top Gold Glow -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-48 h-1 bg-gradient-to-r from-transparent via-[#C9B27C] to-transparent"></div>

        <!-- Header -->
        <div class="text-center mb-8">
          <div class="w-12 h-12 rounded-2xl bg-[#171717] border border-[#C9B27C]/40 flex items-center justify-center text-[#C9B27C] mx-auto mb-4 shadow-inner">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 5.57 4.14 4.14 2.71 2.71 4.14l1.43 1.43L2 7.71l1.43 1.43L2 10.57 3.43 12 7 8.43 15.57 17 12 20.57 13.43 22l1.43-1.43 1.43 1.43 2.14-2.14 1.43 1.43 1.43-1.43-1.43-1.43 1.43-1.43-1.43-1.43 1.43-1.43zM5.57 7L7 5.57l8.43 8.43-1.43 1.43L5.57 7z" />
            </svg>
          </div>
          <span class="text-[10px] font-['Oswald'] uppercase tracking-widest text-[#C9B27C] font-semibold">
            THE FIT MUSCLE GYM
          </span>
          <h1 class="font-['Oswald'] text-3xl font-black text-[#F5F2EA] uppercase mt-1">
            MEMBER PORTAL
          </h1>
          <p class="text-xs text-[#A7A29A] mt-2">
            Sign in with your phone number to access your membership, attendance, and gym check-in.
          </p>
        </div>

        <!-- Alert / Feedback Box -->
        <div id="auth-alert" class="hidden mb-6 p-3.5 rounded-xl text-xs font-medium text-center"></div>

        <!-- STEP 1: Phone Input Form -->
        <form id="phone-form" class="space-y-4">
          <div>
            <label for="phone-input" class="block text-xs font-['Oswald'] uppercase tracking-wider text-[#F5F2EA] mb-2 font-semibold">
              Mobile Number
            </label>
            <div class="relative flex rounded-xl border border-[#2E2E2E] bg-[#0A0A0A] overflow-hidden focus-within:border-[#C9B27C] transition-colors">
              <span class="inline-flex items-center px-4 bg-[#141414] text-xs font-semibold text-[#C9B27C] border-r border-[#242424]">
                +91
              </span>
              <input
                type="tel"
                id="phone-input"
                name="phone"
                maxlength="10"
                required
                placeholder="10-digit phone number"
                class="w-full px-4 py-3 bg-transparent text-[#F5F2EA] placeholder-[#555555] text-sm focus:outline-none"
              />
            </div>
          </div>

          <button
            type="submit"
            id="send-otp-btn"
            class="w-full py-3.5 px-6 rounded-xl font-['Oswald'] text-sm uppercase font-bold tracking-wider bg-[#C9B27C] text-[#080808] hover:bg-[#D8C28E] transition-all cursor-pointer shadow-lg active:scale-95 flex items-center justify-center gap-2 mt-4"
          >
            <span>SEND OTP VIA SMS</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>

        <!-- STEP 2: OTP Verification Form (Hidden Initially) -->
        <form id="otp-form" class="space-y-4 hidden">
          <div>
            <div class="flex items-center justify-between mb-2">
              <label for="otp-input" class="block text-xs font-['Oswald'] uppercase tracking-wider text-[#F5F2EA] font-semibold">
                6-Digit Verification Code
              </label>
              <button
                type="button"
                id="change-phone-btn"
                class="text-[11px] text-[#C9B27C] hover:underline"
              >
                Change Phone
              </button>
            </div>

            <input
              type="text"
              id="otp-input"
              name="otp"
              maxlength="6"
              required
              placeholder="&bull; &bull; &bull; &bull; &bull; &bull;"
              class="w-full px-4 py-3 bg-[#0A0A0A] border border-[#2E2E2E] rounded-xl text-center text-xl font-mono tracking-widest text-[#F5F2EA] placeholder-[#444444] focus:border-[#C9B27C] focus:outline-none"
            />
            <p class="text-[11px] text-[#A7A29A] mt-2 text-center" id="otp-target-hint">
              Enter the 6-digit code sent to your phone
            </p>
          </div>

          <button
            type="submit"
            id="verify-otp-btn"
            class="w-full py-3.5 px-6 rounded-xl font-['Oswald'] text-sm uppercase font-bold tracking-wider bg-[#C9B27C] text-[#080808] hover:bg-[#D8C28E] transition-all cursor-pointer shadow-lg active:scale-95 flex items-center justify-center gap-2 mt-4"
          >
            <span>VERIFY & SIGN IN</span>
          </button>

          <!-- Resend Timer -->
          <div class="text-center pt-2">
            <button
              type="button"
              id="resend-otp-btn"
              disabled
              class="text-xs text-[#7A756D] disabled:opacity-50 hover:text-[#C9B27C] transition-colors"
            >
              Resend OTP in <span id="resend-timer">60</span>s
            </button>
          </div>
        </form>

        <!-- Admin Portal Switch -->
        <div class="mt-8 pt-6 border-t border-[#1E1E1E] text-center">
          <a href="/admin/login" class="text-xs text-[#7A756D] hover:text-[#C9B27C] transition-colors">
            Gym Staff / Trainer Login &rarr;
          </a>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="p-4 text-center text-xs text-[#555555]">
      THE FIT MUSCLE GYM &bull; Dabauli West, Kanpur
    </footer>

    <!-- Auth Script -->
    <script>
      import { formatPhone, sendPhoneOtp, verifyPhoneOtp, getCurrentSession, getCurrentProfile } from '../lib/supabase';

      const phoneForm = document.getElementById('phone-form') as HTMLFormElement | null;
      const otpForm = document.getElementById('otp-form') as HTMLFormElement | null;
      const phoneInput = document.getElementById('phone-input') as HTMLInputElement | null;
      const otpInput = document.getElementById('otp-input') as HTMLInputElement | null;
      const sendOtpBtn = document.getElementById('send-otp-btn') as HTMLButtonElement | null;
      const verifyOtpBtn = document.getElementById('verify-otp-btn') as HTMLButtonElement | null;
      const changePhoneBtn = document.getElementById('change-phone-btn');
      const resendBtn = document.getElementById('resend-otp-btn') as HTMLButtonElement | null;
      const resendTimer = document.getElementById('resend-timer');
      const alertBox = document.getElementById('auth-alert');
      const otpHint = document.getElementById('otp-target-hint');

      let currentPhoneE164 = '';
      let timerInterval: any = null;

      function showAlert(msg: string, isError = true) {
        if (!alertBox) return;
        alertBox.textContent = msg;
        alertBox.className = `mb-6 p-3.5 rounded-xl text-xs font-semibold text-center ${
          isError 
            ? 'bg-[#E53E3E]/15 border border-[#E53E3E]/40 text-[#E53E3E]' 
            : 'bg-[#38A169]/15 border border-[#38A169]/40 text-[#38A169]'
        }`;
        alertBox.classList.remove('hidden');
      }

      function startResendCountdown() {
        if (!resendBtn || !resendTimer) return;
        let count = 60;
        resendBtn.disabled = true;
        resendTimer.textContent = '60';

        clearInterval(timerInterval);
        timerInterval = setInterval(() => {
          count--;
          if (resendTimer) resendTimer.textContent = String(count);
          if (count <= 0) {
            clearInterval(timerInterval);
            if (resendBtn) {
              resendBtn.disabled = false;
              resendBtn.textContent = 'Resend OTP now';
            }
          }
        }, 1000);
      }

      // Check if already authenticated
      async function checkExistingSession() {
        const { session } = await getCurrentSession();
        if (session?.user) {
          const profile = await getCurrentProfile();
          if (profile?.role === 'admin') {
            window.location.href = '/admin';
          } else {
            window.location.href = '/account';
          }
        }
      }
      checkExistingSession();

      // Step 1: Send OTP
      phoneForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const raw = phoneInput?.value.trim() || '';
        if (raw.length < 10) {
          showAlert('Please enter a valid 10-digit mobile number.');
          return;
        }

        currentPhoneE164 = formatPhone(raw);
        if (sendOtpBtn) {
          sendOtpBtn.disabled = true;
          sendOtpBtn.innerHTML = 'Sending OTP...';
        }

        const { error } = await sendPhoneOtp(currentPhoneE164);
        if (sendOtpBtn) {
          sendOtpBtn.disabled = false;
          sendOtpBtn.innerHTML = `<span>SEND OTP VIA SMS</span>`;
        }

        if (error) {
          showAlert(error.message || 'Failed to send OTP. Please try again.');
          return;
        }

        showAlert(`OTP sent to ${currentPhoneE164}. Please enter the 6-digit code.`, false);
        phoneForm.classList.add('hidden');
        otpForm?.classList.remove('hidden');
        if (otpHint) otpHint.textContent = `Enter code sent to ${currentPhoneE164}`;
        otpInput?.focus();
        startResendCountdown();
      });

      // Step 2: Verify OTP
      otpForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const otp = otpInput?.value.trim() || '';
        if (otp.length < 6) {
          showAlert('Please enter the full 6-digit verification code.');
          return;
        }

        if (verifyOtpBtn) {
          verifyOtpBtn.disabled = true;
          verifyOtpBtn.innerHTML = 'Verifying...';
        }

        const { data, error } = await verifyPhoneOtp(currentPhoneE164, otp);
        if (verifyOtpBtn) {
          verifyOtpBtn.disabled = false;
          verifyOtpBtn.innerHTML = '<span>VERIFY & SIGN IN</span>';
        }

        if (error) {
          showAlert(error.message || 'Invalid or expired OTP. Please check and try again.');
          return;
        }

        showAlert('Verification successful! Loading your dashboard...', false);

        // Check user role
        const profile = await getCurrentProfile();
        setTimeout(() => {
          if (profile?.role === 'admin') {
            window.location.href = '/admin';
          } else {
            window.location.href = '/account';
          }
        }, 600);
      });

      // Change phone number button
      changePhoneBtn?.addEventListener('click', () => {
        otpForm?.classList.add('hidden');
        phoneForm?.classList.remove('hidden');
        alertBox?.classList.add('hidden');
        clearInterval(timerInterval);
        phoneInput?.focus();
      });

      // Resend OTP
      resendBtn?.addEventListener('click', async () => {
        if (!currentPhoneE164) return;
        resendBtn.disabled = true;
        resendBtn.textContent = 'Sending...';
        const { error } = await sendPhoneOtp(currentPhoneE164);
        if (error) {
          showAlert(error.message || 'Failed to resend OTP.');
          resendBtn.disabled = false;
          resendBtn.textContent = 'Resend OTP now';
        } else {
          showAlert(`New OTP sent to ${currentPhoneE164}`, false);
          startResendCountdown();
        }
      });
    </script>
  </body>
</html>
