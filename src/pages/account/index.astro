---
import AccountLayout from "../../layouts/AccountLayout.astro";
import QRScannerModal from "../../components/QRScannerModal.astro";
---

<AccountLayout title="Dashboard | THE FIT MUSCLE GYM">
  <!-- Loading Skeleton State -->
  <div id="account-loading" class="space-y-6">
    <div class="h-36 rounded-3xl bg-[#141414] animate-pulse border border-[#222222]"></div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="h-44 rounded-2xl bg-[#141414] animate-pulse border border-[#222222]"></div>
      <div class="h-44 rounded-2xl bg-[#141414] animate-pulse border border-[#222222]"></div>
      <div class="h-44 rounded-2xl bg-[#141414] animate-pulse border border-[#222222]"></div>
    </div>
  </div>

  <!-- Main Dashboard Content (Revealed after fetch) -->
  <div id="account-content" class="hidden space-y-8">
    <!-- Top Welcome Banner & QR Action -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-[#171717] via-[#141414] to-[#171717] border border-[#2A2A2A] p-6 sm:p-8 shadow-2xl flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="space-y-2">
        <div class="flex items-center gap-3">
          <span class="text-xs uppercase font-['Oswald'] tracking-widest text-[#C9B27C] font-semibold">
            MEMBER PROFILE
          </span>
          <span id="member-badge-id" class="px-2.5 py-0.5 rounded-full bg-[#080808] border border-[#333333] text-[10px] font-mono text-[#A7A29A]">
            ID: ...
          </span>
        </div>
        <h1 id="member-name-heading" class="font-['Oswald'] text-3xl sm:text-4xl font-black text-[#F5F2EA] uppercase tracking-wide">
          WELCOME
        </h1>
        <p class="text-xs sm:text-sm text-[#A7A29A] flex items-center gap-2">
          <span>Phone: <strong id="member-phone-label" class="text-[#F5F2EA] font-mono">...</strong></span>
        </p>
      </div>

      <!-- Prominent QR Check-In Action Button -->
      <div class="flex flex-col sm:flex-row items-center gap-3">
        <button
          type="button"
          data-open-qr-scanner
          class="w-full sm:w-auto px-6 py-4 rounded-2xl bg-[#C9B27C] hover:bg-[#D8C28E] text-[#080808] font-['Oswald'] text-base uppercase font-extrabold tracking-wider transition-all duration-200 shadow-[0_0_25px_rgba(201,178,124,0.3)] hover:shadow-[0_0_35px_rgba(201,178,124,0.45)] cursor-pointer flex items-center justify-center gap-3 active:scale-95"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
          </svg>
          <span>SCAN ATTENDANCE QR</span>
        </button>
      </div>
    </div>

    <!-- Active Membership Card -->
    <div class="bg-[#141414] rounded-3xl border border-[#242424] p-6 sm:p-8 shadow-xl">
      <div class="flex items-center justify-between pb-6 border-b border-[#222222]">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-[#171717] border border-[#C9B27C]/40 flex items-center justify-center text-[#C9B27C]">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div>
            <span class="text-[10px] font-['Oswald'] uppercase tracking-widest text-[#A7A29A] block">
              MEMBERSHIP PLAN
            </span>
            <h2 id="plan-name-label" class="font-['Oswald'] text-2xl sm:text-3xl font-bold text-[#F5F2EA] uppercase">
              No Active Plan
            </h2>
          </div>
        </div>

        <div id="plan-status-badge" class="px-3.5 py-1.5 rounded-full border text-xs font-['Oswald'] uppercase font-bold tracking-wider">
          Inactive
        </div>
      </div>

      <!-- Plan Metadata Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 mt-6">
        <div class="p-4 rounded-2xl bg-[#0C0C0C] border border-[#1E1E1E]">
          <span class="text-[11px] text-[#A7A29A] uppercase tracking-wider block font-['Oswald']">Plan Price</span>
          <span id="plan-price-label" class="font-['Oswald'] text-xl font-bold text-[#C9B27C] mt-1 block">
            ₹0
          </span>
        </div>

        <div class="p-4 rounded-2xl bg-[#0C0C0C] border border-[#1E1E1E]">
          <span class="text-[11px] text-[#A7A29A] uppercase tracking-wider block font-['Oswald']">Start Date</span>
          <span id="plan-start-date" class="font-['DM_Sans'] text-sm font-semibold text-[#F5F2EA] mt-1 block">
            —
          </span>
        </div>

        <div class="p-4 rounded-2xl bg-[#0C0C0C] border border-[#1E1E1E]">
          <span class="text-[11px] text-[#A7A29A] uppercase tracking-wider block font-['Oswald']">Expiry Date</span>
          <span id="plan-end-date" class="font-['DM_Sans'] text-sm font-semibold text-[#F5F2EA] mt-1 block">
            —
          </span>
        </div>

        <div class="p-4 rounded-2xl bg-[#0C0C0C] border border-[#1E1E1E]">
          <span class="text-[11px] text-[#A7A29A] uppercase tracking-wider block font-['Oswald']">Days Remaining</span>
          <span id="plan-days-remaining" class="font-['Oswald'] text-xl font-bold text-[#F5F2EA] mt-1 block">
            0 days
          </span>
        </div>
      </div>
    </div>

    <!-- Attendance & Stats Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Attendance Overview -->
      <div class="lg:col-span-6 bg-[#141414] rounded-3xl border border-[#242424] p-6 sm:p-7 shadow-xl flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-4 border-b border-[#222222]">
            <h3 class="font-['Oswald'] text-xl font-bold text-[#F5F2EA] uppercase">
              ATTENDANCE RECORD
            </h3>
            <a href="/account/attendance" class="text-xs text-[#C9B27C] hover:underline font-semibold">
              View All History &rarr;
            </a>
          </div>

          <!-- Quick Numbers -->
          <div class="grid grid-cols-2 gap-4 mt-6">
            <div class="p-4 rounded-2xl bg-[#0C0C0C] border border-[#1E1E1E] text-center">
              <span class="font-['Oswald'] text-3xl font-bold text-[#C9B27C]" id="attendance-month-count">0</span>
              <span class="text-[11px] text-[#A7A29A] block mt-1 uppercase font-['Oswald']">Days This Month</span>
            </div>
            <div class="p-4 rounded-2xl bg-[#0C0C0C] border border-[#1E1E1E] text-center">
              <span class="font-['Oswald'] text-3xl font-bold text-[#F5F2EA]" id="attendance-total-count">0</span>
              <span class="text-[11px] text-[#A7A29A] block mt-1 uppercase font-['Oswald']">Total Workouts</span>
            </div>
          </div>

          <!-- Today's Status Banner -->
          <div id="today-attendance-status" class="mt-4 p-4 rounded-2xl border text-xs text-center font-medium">
            Checking today's check-in status...
          </div>
        </div>

        <!-- Recent 3 Attendances List -->
        <div class="mt-6 pt-4 border-t border-[#222222]">
          <span class="text-[11px] font-['Oswald'] uppercase tracking-wider text-[#7A756D] block mb-3">
            Recent Check-Ins
          </span>
          <div id="recent-attendance-list" class="space-y-2">
            <p class="text-xs text-[#7A756D] italic">No attendance records found yet.</p>
          </div>
        </div>
      </div>

      <!-- Payment / Membership History Ledger -->
      <div class="lg:col-span-6 bg-[#141414] rounded-3xl border border-[#242424] p-6 sm:p-7 shadow-xl">
        <div class="flex items-center justify-between pb-4 border-b border-[#222222]">
          <h3 class="font-['Oswald'] text-xl font-bold text-[#F5F2EA] uppercase">
            PAYMENT HISTORY
          </h3>
          <span class="text-[11px] text-[#A7A29A]">Offline Receipts</span>
        </div>

        <p class="text-xs text-[#7A756D] mt-3">
          Payments recorded at the gym front desk (Cash / UPI).
        </p>

        <!-- Payments Table -->
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="text-[#7A756D] border-b border-[#222222]">
                <th class="py-2 font-['Oswald'] uppercase tracking-wider">Date</th>
                <th class="py-2 font-['Oswald'] uppercase tracking-wider">Amount</th>
                <th class="py-2 font-['Oswald'] uppercase tracking-wider">Method</th>
                <th class="py-2 font-['Oswald'] uppercase tracking-wider">Status</th>
              </tr>
            </thead>
            <tbody id="payment-history-tbody" class="divide-y divide-[#1C1C1C]">
              <tr>
                <td colspan="4" class="py-4 text-center text-[#7A756D] italic">
                  No payment records found.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- QR Scanner Modal -->
  <QRScannerModal />
</AccountLayout>

<script>
  import { 
    getSupabase, 
    getCurrentSession, 
    getCurrentProfile,
    formatDate, 
    formatTime, 
    formatCurrency, 
    getMembershipDisplayStatus,
    getDaysRemaining 
  } from '../../lib/supabase';

  async function loadDashboard() {
    const sb = getSupabase();
    const { session } = await getCurrentSession();
    if (!session?.user) return;

    const profile = await getCurrentProfile();
    const userId = session.user.id;

    // 1. Populate Profile Information
    const nameEl = document.getElementById('member-name-heading');
    const phoneEl = document.getElementById('member-phone-label');
    const badgeIdEl = document.getElementById('member-badge-id');

    if (nameEl) nameEl.textContent = profile?.full_name || 'GYM MEMBER';
    if (phoneEl) phoneEl.textContent = profile?.phone || session.user.phone || '—';
    if (badgeIdEl) badgeIdEl.textContent = `ID: ${userId.substring(0, 8).toUpperCase()}`;

    // 2. Fetch Active Membership
    const { data: memberships } = await sb
      .from('memberships')
      .select('*, membership_plans(*)')
      .eq('member_id', userId)
      .order('end_date', { ascending: false })
      .limit(1);

    const activeMembership = memberships && memberships.length > 0 ? memberships[0] : null;

    if (activeMembership) {
      const planName = activeMembership.membership_plans?.name || 'Custom Plan';
      const planPrice = activeMembership.membership_plans?.price || 0;
      const statusInfo = getMembershipDisplayStatus(activeMembership.end_date, activeMembership.status);

      const planNameEl = document.getElementById('plan-name-label');
      const planPriceEl = document.getElementById('plan-price-label');
      const planStartEl = document.getElementById('plan-start-date');
      const planEndEl = document.getElementById('plan-end-date');
      const planDaysEl = document.getElementById('plan-days-remaining');
      const planBadgeEl = document.getElementById('plan-status-badge');

      if (planNameEl) planNameEl.textContent = planName;
      if (planPriceEl) planPriceEl.textContent = formatCurrency(planPrice);
      if (planStartEl) planStartEl.textContent = formatDate(activeMembership.start_date);
      if (planEndEl) planEndEl.textContent = formatDate(activeMembership.end_date);
      if (planDaysEl) {
        planDaysEl.textContent = `${statusInfo.daysRemaining >= 0 ? statusInfo.daysRemaining : 0} days`;
        planDaysEl.className = `font-['Oswald'] text-xl font-bold mt-1 block ${statusInfo.colorClass}`;
      }
      if (planBadgeEl) {
        planBadgeEl.textContent = statusInfo.label;
        planBadgeEl.className = `px-3.5 py-1.5 rounded-full border text-xs font-['Oswald'] uppercase font-bold tracking-wider ${statusInfo.badgeClass}`;
      }
    }

    // 3. Fetch Attendance History
    const { data: attendances } = await sb
      .from('attendance')
      .select('*')
      .eq('member_id', userId)
      .order('check_in_date', { ascending: false });

    const attList = attendances || [];
    const totalCountEl = document.getElementById('attendance-total-count');
    const monthCountEl = document.getElementById('attendance-month-count');
    const todayStatusEl = document.getElementById('today-attendance-status');
    const recentListEl = document.getElementById('recent-attendance-list');

    if (totalCountEl) totalCountEl.textContent = String(attList.length);

    // Filter current month
    const currentMonth = new Date().toISOString().substring(0, 7); // YYYY-MM
    const monthCount = attList.filter((a) => a.check_in_date?.startsWith(currentMonth)).length;
    if (monthCountEl) monthCountEl.textContent = String(monthCount);

    // Today's attendance check
    const todayStr = new Date().toISOString().substring(0, 10); // YYYY-MM-DD
    const todayCheckin = attList.find((a) => a.check_in_date === todayStr);

    if (todayStatusEl) {
      if (todayCheckin) {
        todayStatusEl.textContent = `✓ Checked in today at ${formatTime(todayCheckin.check_in_time)}`;
        todayStatusEl.className = 'mt-4 p-4 rounded-2xl border border-[#38A169]/40 bg-[#38A169]/10 text-[#38A169] text-xs text-center font-bold';
      } else {
        todayStatusEl.textContent = 'Not checked in yet today. Scan the gym counter QR when you arrive!';
        todayStatusEl.className = 'mt-4 p-4 rounded-2xl border border-[#242424] bg-[#0C0C0C] text-[#A7A29A] text-xs text-center';
      }
    }

    // Recent 3 list
    if (recentListEl && attList.length > 0) {
      recentListEl.innerHTML = attList.slice(0, 3).map((a) => `
        <div class="flex items-center justify-between p-2.5 rounded-xl bg-[#0C0C0C] border border-[#1E1E1E] text-xs">
          <span class="font-medium text-[#F5F2EA]">${formatDate(a.check_in_date)}</span>
          <span class="text-[#C9B27C] font-mono text-[11px]">${formatTime(a.check_in_time)}</span>
        </div>
      `).join('');
    }

    // 4. Fetch Payment Records
    const { data: payments } = await sb
      .from('payments')
      .select('*')
      .eq('member_id', userId)
      .order('payment_date', { ascending: false });

    const payList = payments || [];
    const tbody = document.getElementById('payment-history-tbody');

    if (tbody && payList.length > 0) {
      tbody.innerHTML = payList.map((p) => {
        const methodBadge = (p.payment_method || 'cash').toUpperCase();
        const statusBadge = (p.payment_status || 'paid');
        const statusColor = statusBadge === 'paid' ? 'text-[#38A169]' : 'text-[#D69E2E]';

        return `
          <tr class="hover:bg-[#1A1A1A]/50 transition-colors">
            <td class="py-3 text-[#F5F2EA] font-medium">${formatDate(p.payment_date)}</td>
            <td class="py-3 font-bold text-[#C9B27C]">${formatCurrency(p.amount)}</td>
            <td class="py-3">
              <span class="px-2 py-0.5 rounded bg-[#1C1C1C] text-[10px] font-['Oswald'] uppercase text-[#A7A29A] border border-[#2E2E2E]">
                ${methodBadge}
              </span>
            </td>
            <td class="py-3 capitalize ${statusColor} font-semibold">${statusBadge}</td>
          </tr>
        `;
      }).join('');
    }

    // Reveal content
    document.getElementById('account-loading')?.classList.add('hidden');
    document.getElementById('account-content')?.classList.remove('hidden');
  }

  loadDashboard();
</script>
