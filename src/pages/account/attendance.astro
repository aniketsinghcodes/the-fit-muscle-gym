---
import AccountLayout from "../../layouts/AccountLayout.astro";
import QRScannerModal from "../../components/QRScannerModal.astro";
---

<AccountLayout title="Attendance History | THE FIT MUSCLE GYM">
  <div class="space-y-6">
    <!-- Header with Back Link -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[#222222]">
      <div>
        <a href="/account" class="text-xs text-[#C9B27C] hover:underline mb-2 inline-flex items-center gap-1 font-semibold">
          &larr; Back to Dashboard
        </a>
        <h1 class="font-['Oswald'] text-3xl font-black text-[#F5F2EA] uppercase tracking-wide">
          ATTENDANCE LOG
        </h1>
        <p class="text-xs sm:text-sm text-[#A7A29A] mt-1">
          Complete verified record of your workouts and check-in times at THE FIT MUSCLE GYM.
        </p>
      </div>

      <button
        type="button"
        data-open-qr-scanner
        class="px-5 py-3 rounded-xl bg-[#C9B27C] hover:bg-[#D8C28E] text-[#080808] font-['Oswald'] uppercase font-bold text-xs tracking-wider transition-all cursor-pointer shadow-md flex items-center justify-center gap-2 self-start sm:self-auto"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
        </svg>
        <span>SCAN TODAY'S QR</span>
      </button>
    </div>

    <!-- Attendance Stats Counters -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="p-5 rounded-2xl bg-[#141414] border border-[#242424] text-center">
        <span id="stat-total" class="font-['Oswald'] text-3xl font-bold text-[#C9B27C] block">0</span>
        <span class="text-[11px] text-[#A7A29A] uppercase tracking-wider font-['Oswald'] block mt-1">Total Workouts</span>
      </div>
      <div class="p-5 rounded-2xl bg-[#141414] border border-[#242424] text-center">
        <span id="stat-month" class="font-['Oswald'] text-3xl font-bold text-[#F5F2EA] block">0</span>
        <span class="text-[11px] text-[#A7A29A] uppercase tracking-wider font-['Oswald'] block mt-1">This Month</span>
      </div>
      <div class="p-5 rounded-2xl bg-[#141414] border border-[#242424] text-center">
        <span id="stat-last" class="font-['DM_Sans'] text-sm font-bold text-[#F5F2EA] block truncate mt-2">None</span>
        <span class="text-[11px] text-[#A7A29A] uppercase tracking-wider font-['Oswald'] block mt-1">Last Workout</span>
      </div>
      <div class="p-5 rounded-2xl bg-[#141414] border border-[#242424] text-center">
        <span id="stat-today" class="font-['Oswald'] text-xl font-bold text-[#38A169] block mt-1">Pending</span>
        <span class="text-[11px] text-[#A7A29A] uppercase tracking-wider font-['Oswald'] block mt-1">Today</span>
      </div>
    </div>

    <!-- Attendance Records Table -->
    <div class="bg-[#141414] rounded-3xl border border-[#242424] p-6 sm:p-8 shadow-xl">
      <div class="flex items-center justify-between pb-4 border-b border-[#222222]">
        <h2 class="font-['Oswald'] text-xl font-bold text-[#F5F2EA] uppercase">
          CHRONOLOGICAL LOG
        </h2>
        <span id="records-count-badge" class="text-xs text-[#A7A29A] font-mono">0 records</span>
      </div>

      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead>
            <tr class="text-[#7A756D] border-b border-[#222222] font-['Oswald'] uppercase tracking-wider text-xs">
              <th class="py-3 px-2">#</th>
              <th class="py-3 px-2">Date</th>
              <th class="py-3 px-2">Exact Entry Time</th>
              <th class="py-3 px-2">Status</th>
            </tr>
          </thead>
          <tbody id="attendance-full-tbody" class="divide-y divide-[#1C1C1C]">
            <tr>
              <td colspan="4" class="py-8 text-center text-[#7A756D] italic">
                Loading attendance history...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <QRScannerModal />
</AccountLayout>

<script>
  import { getSupabase, getCurrentSession, formatDate, formatTime } from '../../lib/supabase';

  async function loadAttendancePage() {
    const sb = getSupabase();
    const { session } = await getCurrentSession();
    if (!session?.user) return;

    const userId = session.user.id;

    const { data: records, error } = await sb
      .from('attendance')
      .select('*')
      .eq('member_id', userId)
      .order('check_in_date', { ascending: false });

    const attList = records || [];

    // Populate counters
    const totalEl = document.getElementById('stat-total');
    const monthEl = document.getElementById('stat-month');
    const lastEl = document.getElementById('stat-last');
    const todayEl = document.getElementById('stat-today');
    const countBadge = document.getElementById('records-count-badge');
    const tbody = document.getElementById('attendance-full-tbody');

    if (totalEl) totalEl.textContent = String(attList.length);
    if (countBadge) countBadge.textContent = `${attList.length} check-in${attList.length === 1 ? '' : 's'}`;

    const currentMonth = new Date().toISOString().substring(0, 7);
    const monthCount = attList.filter((a) => a.check_in_date?.startsWith(currentMonth)).length;
    if (monthEl) monthEl.textContent = String(monthCount);

    if (lastEl && attList.length > 0) {
      lastEl.textContent = formatDate(attList[0].check_in_date);
    }

    const todayStr = new Date().toISOString().substring(0, 10);
    const checkedToday = attList.find((a) => a.check_in_date === todayStr);
    if (todayEl) {
      if (checkedToday) {
        todayEl.textContent = `✓ Checked In (${formatTime(checkedToday.check_in_time)})`;
        todayEl.className = "font-['Oswald'] text-sm font-bold text-[#38A169] block mt-1";
      } else {
        todayEl.textContent = 'Not Checked In';
        todayEl.className = "font-['Oswald'] text-sm font-bold text-[#A7A29A] block mt-1";
      }
    }

    if (tbody) {
      if (attList.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="4" class="py-8 text-center text-[#7A756D] italic">
              No attendance records found yet. Scan the gym QR when you enter!
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = attList.map((a, index) => {
        const method = a.check_in_method;
        const isQR = method === 'qr';
        const isManual = method === 'manual';
        const label = isQR ? 'QR Verified' : isManual ? 'Front Desk' : 'Verified Entry';
        const badgeClasses = isQR 
          ? 'bg-[#38A169]/15 text-[#38A169] border-[#38A169]/30' 
          : isManual 
          ? 'bg-[#C9B27C]/15 text-[#C9B27C] border-[#C9B27C]/30' 
          : 'bg-[#4A5568]/20 text-[#A0AEC0] border-[#4A5568]/40';
        const dotClasses = isQR ? 'bg-[#38A169]' : isManual ? 'bg-[#C9B27C]' : 'bg-[#A0AEC0]';

        return `
          <tr class="hover:bg-[#1A1A1A]/50 transition-colors">
            <td class="py-3.5 px-2 text-[#7A756D] font-mono text-xs">${attList.length - index}</td>
            <td class="py-3.5 px-2 font-medium text-[#F5F2EA]">${formatDate(a.check_in_date)}</td>
            <td class="py-3.5 px-2 font-mono text-xs text-[#C9B27C]">${formatTime(a.check_in_time)}</td>
            <td class="py-3.5 px-2">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold border ${badgeClasses}">
                <span class="w-1.5 h-1.5 rounded-full ${dotClasses}"></span>
                ${label}
              </span>
            </td>
          </tr>
        `;
      }).join('');
    }
  }

  loadAttendancePage();
</script>
