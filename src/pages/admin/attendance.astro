---
import AdminLayout from "../../layouts/AdminLayout.astro";
import OfficialGymQRModal from "../../components/OfficialGymQRModal.astro";
---

<AdminLayout title="Attendance & QR | Admin Console" activeNav="attendance">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[#242424]">
      <div>
        <span class="text-xs uppercase font-['Oswald'] tracking-widest text-[#C9B27C] font-semibold">
          CHECK-IN & QR VERIFICATION
        </span>
        <h1 class="font-['Oswald'] text-3xl font-black text-[#F5F2EA] uppercase tracking-wide mt-1">
          ATTENDANCE MANAGEMENT
        </h1>
        <p class="text-xs sm:text-sm text-[#A7A29A] mt-1">
          Monitor front desk entries, verify workout timestamps, and manage the official gym QR.
        </p>
      </div>

      <!-- Header Action Buttons -->
      <div class="flex flex-wrap items-center gap-3">
        <button
          type="button"
          data-open-admin-qr
          class="px-4 py-2.5 rounded-xl bg-[#171717] hover:bg-[#222222] border border-[#C9B27C]/40 text-[#C9B27C] font-['Oswald'] text-xs font-bold uppercase tracking-wider transition-all cursor-pointer flex items-center gap-2 shadow"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
          </svg>
          <span>Display Gym QR</span>
        </button>

        <button
          type="button"
          id="open-manual-checkin-btn"
          class="px-4 py-2.5 rounded-xl bg-[#C9B27C] hover:bg-[#D8C28E] text-[#080808] font-['Oswald'] text-xs font-bold uppercase tracking-wider transition-all cursor-pointer flex items-center gap-2 shadow"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          <span>Manual Check-in</span>
        </button>
      </div>
    </div>

    <!-- Attendance Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="p-5 rounded-2xl bg-[#141414] border border-[#242424]">
        <span class="text-[11px] font-['Oswald'] uppercase tracking-wider text-[#C9B27C] block">
          Today's Check-ins
        </span>
        <span id="stat-today" class="font-['Oswald'] text-3xl font-black text-[#F5F2EA] mt-1 block">
          0
        </span>
        <span class="text-[10px] text-[#7A756D] mt-1 block">Present today at gym</span>
      </div>

      <div class="p-5 rounded-2xl bg-[#141414] border border-[#242424]">
        <span class="text-[11px] font-['Oswald'] uppercase tracking-wider text-[#A7A29A] block">
          This Month
        </span>
        <span id="stat-month" class="font-['Oswald'] text-3xl font-black text-[#F5F2EA] mt-1 block">
          0
        </span>
        <span class="text-[10px] text-[#7A756D] mt-1 block">Total monthly visits</span>
      </div>

      <div class="p-5 rounded-2xl bg-[#141414] border border-[#242424]">
        <span class="text-[11px] font-['Oswald'] uppercase tracking-wider text-[#A7A29A] block">
          Total Workouts
        </span>
        <span id="stat-total" class="font-['Oswald'] text-3xl font-black text-[#F5F2EA] mt-1 block">
          0
        </span>
        <span class="text-[10px] text-[#7A756D] mt-1 block">Lifetime check-ins</span>
      </div>

      <div class="p-5 rounded-2xl bg-[#141414] border border-[#242424]">
        <span class="text-[11px] font-['Oswald'] uppercase tracking-wider text-[#38A169] block">
          Front Desk QR
        </span>
        <span id="stat-qr-status" class="font-['Oswald'] text-xl font-bold text-[#38A169] mt-2 block uppercase">
          Active
        </span>
        <span class="text-[10px] text-[#7A756D] block">Token is ready</span>
      </div>
    </div>

    <!-- Search & Filters -->
    <div class="p-4 rounded-2xl bg-[#141414] border border-[#242424] flex flex-col md:flex-row items-center gap-4">
      <div class="relative flex-1 w-full">
        <input
          type="text"
          id="attendance-search-input"
          placeholder="Filter by member name or phone..."
          class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-[#0A0A0A] border border-[#2E2E2E] text-xs sm:text-sm text-[#F5F2EA] placeholder-[#555555] focus:border-[#C9B27C] focus:outline-none"
        />
        <svg class="w-4 h-4 text-[#7A756D] absolute left-3.5 top-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <div class="flex items-center gap-2 w-full md:w-auto">
        <label for="attendance-date-picker" class="text-xs text-[#A7A29A] font-['Oswald'] uppercase tracking-wider hidden sm:inline">
          Date:
        </label>
        <input
          type="date"
          id="attendance-date-picker"
          class="px-3 py-2 rounded-xl bg-[#0A0A0A] border border-[#2E2E2E] text-xs text-[#F5F2EA] focus:border-[#C9B27C] focus:outline-none"
        />

        <button
          type="button"
          id="clear-date-filter-btn"
          class="px-3 py-2 rounded-xl bg-[#1C1C1C] hover:bg-[#282828] text-xs text-[#A7A29A] hover:text-[#F5F2EA] transition-colors"
          title="Show All Dates"
        >
          All
        </button>
      </div>
    </div>

    <!-- Attendance Log Table -->
    <div class="bg-[#141414] rounded-3xl border border-[#242424] overflow-hidden shadow-xl">
      <div class="flex items-center justify-between p-5 border-b border-[#242424] bg-[#111111]">
        <div class="flex items-center gap-3">
          <h2 class="font-['Oswald'] text-lg font-bold text-[#F5F2EA] uppercase">
            CHECK-IN RECORDS
          </h2>
          <span id="filtered-records-count" class="px-2.5 py-0.5 rounded-full bg-[#1C1C1C] text-[11px] font-mono text-[#C9B27C]">
            0 entries
          </span>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead>
            <tr class="text-[#7A756D] border-b border-[#242424] bg-[#0E0E0E] font-['Oswald'] uppercase tracking-wider text-xs">
              <th class="py-3.5 px-4">#</th>
              <th class="py-3.5 px-4">Member Name</th>
              <th class="py-3.5 px-4">Phone</th>
              <th class="py-3.5 px-4">Date</th>
              <th class="py-3.5 px-4">Exact Entry Time</th>
              <th class="py-3.5 px-4">Method</th>
              <th class="py-3.5 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="attendance-table-tbody" class="divide-y divide-[#1C1C1C]">
            <tr>
              <td colspan="7" class="py-12 text-center text-[#7A756D] italic">
                Loading attendance records from database...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- MANUAL CHECK-IN MODAL -->
  <div
    id="manual-checkin-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
  >
    <div class="w-full max-w-md bg-[#141414] border border-[#2E2E2E] rounded-3xl p-6 sm:p-8 shadow-2xl space-y-5">
      <div class="flex items-center justify-between pb-3 border-b border-[#242424]">
        <div>
          <span class="text-[10px] font-['Oswald'] uppercase tracking-widest text-[#C9B27C] font-semibold">
            FRONT DESK
          </span>
          <h3 class="font-['Oswald'] text-2xl font-bold text-[#F5F2EA] uppercase mt-0.5">
            Manual Check-in
          </h3>
        </div>
        <button type="button" id="close-manual-modal-btn" class="p-2 rounded-xl text-[#A7A29A] hover:text-[#F5F2EA]">
          ✕
        </button>
      </div>

      <form id="manual-checkin-form" class="space-y-4">
        <div>
          <label for="manual-member-select" class="block text-xs font-['Oswald'] uppercase tracking-wider text-[#F5F2EA] mb-1 font-semibold">
            Select Member *
          </label>
          <select
            id="manual-member-select"
            required
            class="w-full px-3.5 py-2.5 rounded-xl bg-[#0A0A0A] border border-[#2E2E2E] text-xs text-[#F5F2EA] focus:border-[#C9B27C] focus:outline-none"
          >
            <option value="">Loading members...</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="manual-date-input" class="block text-xs font-['Oswald'] uppercase tracking-wider text-[#F5F2EA] mb-1 font-semibold">
              Date *
            </label>
            <input
              type="date"
              id="manual-date-input"
              required
              class="w-full px-3.5 py-2.5 rounded-xl bg-[#0A0A0A] border border-[#2E2E2E] text-xs text-[#F5F2EA] focus:border-[#C9B27C] focus:outline-none"
            />
          </div>

          <div>
            <label for="manual-time-input" class="block text-xs font-['Oswald'] uppercase tracking-wider text-[#F5F2EA] mb-1 font-semibold">
              Entry Time *
            </label>
            <input
              type="time"
              id="manual-time-input"
              required
              class="w-full px-3.5 py-2.5 rounded-xl bg-[#0A0A0A] border border-[#2E2E2E] text-xs text-[#F5F2EA] focus:border-[#C9B27C] focus:outline-none"
            />
          </div>
        </div>

        <p class="text-[11px] text-[#7A756D]">
          Used when a member forgets their phone or needs front desk assistance. System prevents duplicate check-ins on the same calendar day.
        </p>

        <div class="pt-3 flex items-center justify-end gap-3">
          <button
            type="button"
            id="cancel-manual-modal-btn"
            class="px-4 py-2.5 rounded-xl bg-[#1E1E1E] text-xs text-[#A7A29A] hover:text-[#F5F2EA]"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="save-manual-checkin-btn"
            class="px-6 py-2.5 rounded-xl bg-[#C9B27C] text-[#080808] font-['Oswald'] text-xs uppercase font-bold tracking-wider hover:bg-[#D8C28E] cursor-pointer"
          >
            CONFIRM CHECK-IN
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- QR Modal -->
  <OfficialGymQRModal />
</AdminLayout>

<script>
  import { getSupabase, formatDate, formatTime } from '../../lib/supabase';
  import type { Attendance, Profile } from '../../types/database';

  let allAttendance: (Attendance & { profiles?: Profile })[] = [];
  let membersList: Profile[] = [];
  let selectedDateFilter: string = new Date().toISOString().substring(0, 10); // default to today

  const tbody = document.getElementById('attendance-table-tbody');
  const countBadge = document.getElementById('filtered-records-count');
  const searchInput = document.getElementById('attendance-search-input') as HTMLInputElement | null;
  const datePicker = document.getElementById('attendance-date-picker') as HTMLInputElement | null;
  const clearDateBtn = document.getElementById('clear-date-filter-btn');

  // Manual check-in elements
  const manualModal = document.getElementById('manual-checkin-modal');
  const openManualBtn = document.getElementById('open-manual-checkin-btn');
  const closeManualBtn = document.getElementById('close-manual-modal-btn');
  const cancelManualBtn = document.getElementById('cancel-manual-modal-btn');
  const manualForm = document.getElementById('manual-checkin-form') as HTMLFormElement | null;
  const memberSelect = document.getElementById('manual-member-select') as HTMLSelectElement | null;
  const manualDateInput = document.getElementById('manual-date-input') as HTMLInputElement | null;
  const manualTimeInput = document.getElementById('manual-time-input') as HTMLInputElement | null;

  async function loadData() {
    const sb = getSupabase();

    // 1. Fetch all attendance records with profiles joined
    const { data: records, error } = await sb
      .from('attendance')
      .select('*, profiles(*)')
      .order('check_in_date', { ascending: false })
      .order('check_in_time', { ascending: false });

    if (error) {
      console.error('Error fetching attendance:', error);
      if (tbody) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" class="py-12 text-center text-[#E53E3E]">
              Failed to load attendance records. ${error.message}
            </td>
          </tr>
        `;
      }
      return;
    }

    allAttendance = (records || []) as (Attendance & { profiles?: Profile })[];

    // 2. Fetch profiles for manual check-in dropdown
    const { data: profs } = await sb
      .from('profiles')
      .select('*')
      .order('full_name', { ascending: true });

    membersList = (profs || []).filter((p) => p.role === 'member') as Profile[];
    populateMemberSelect();

    // 3. Compute KPI counters
    updateKPICounters();

    // Set initial date filter to today
    if (datePicker) {
      datePicker.value = selectedDateFilter;
    }

    // Render table
    renderTable();
  }

  function updateKPICounters() {
    const todayStr = new Date().toISOString().substring(0, 10);
    const thisMonthStr = todayStr.substring(0, 7);

    let todayCount = 0;
    let monthCount = 0;

    allAttendance.forEach((rec) => {
      if (rec.check_in_date === todayStr) todayCount++;
      if (rec.check_in_date && rec.check_in_date.startsWith(thisMonthStr)) monthCount++;
    });

    const statToday = document.getElementById('stat-today');
    const statMonth = document.getElementById('stat-month');
    const statTotal = document.getElementById('stat-total');

    if (statToday) statToday.textContent = String(todayCount);
    if (statMonth) statMonth.textContent = String(monthCount);
    if (statTotal) statTotal.textContent = String(allAttendance.length);
  }

  function populateMemberSelect() {
    if (!memberSelect) return;
    if (membersList.length === 0) {
      memberSelect.innerHTML = `<option value="">No members registered yet</option>`;
      return;
    }

    memberSelect.innerHTML = `
      <option value="">Select Member</option>
      ${membersList
        .map(
          (m) => `
        <option value="${m.id}">${m.full_name || 'Member'} (${m.phone || 'No phone'})</option>
      `
        )
        .join('')}
    `;
  }

  function renderTable() {
    if (!tbody) return;

    const searchTerm = (searchInput?.value || '').trim().toLowerCase();

    const filtered = allAttendance.filter((rec) => {
      // Date filter
      if (selectedDateFilter && rec.check_in_date !== selectedDateFilter) {
        return false;
      }

      // Search term filter
      if (searchTerm) {
        const name = (rec.profiles?.full_name || '').toLowerCase();
        const phone = (rec.profiles?.phone || '').toLowerCase();
        const id = (rec.member_id || '').toLowerCase();
        if (!name.includes(searchTerm) && !phone.includes(searchTerm) && !id.includes(searchTerm)) {
          return false;
        }
      }

      return true;
    });

    if (countBadge) {
      countBadge.textContent = `${filtered.length} entries`;
    }

    if (filtered.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="7" class="py-12 text-center text-[#7A756D]">
            No attendance records found ${selectedDateFilter ? `for ${formatDate(selectedDateFilter)}` : ''}.
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = filtered
      .map((rec, idx) => {
        const name = rec.profiles?.full_name || 'Member';
        const phone = rec.profiles?.phone || '—';
        const formattedDate = formatDate(rec.check_in_date);
        const formattedTime = formatTime(rec.check_in_time);
        
        const method = rec.check_in_method;
        const isQR = method === 'qr';
        const isManual = method === 'manual';
        const methodLabel = isQR 
          ? 'QR Scanned' 
          : isManual 
          ? 'Front Desk Manual' 
          : 'Verified Entry';

        const badgeStyle = isQR
          ? 'bg-[#38A169]/15 text-[#38A169] border-[#38A169]/30'
          : isManual
          ? 'bg-[#C9B27C]/15 text-[#C9B27C] border-[#C9B27C]/30'
          : 'bg-[#4A5568]/20 text-[#A0AEC0] border-[#4A5568]/40';

        const dotColor = isQR ? 'bg-[#38A169]' : isManual ? 'bg-[#C9B27C]' : 'bg-[#A0AEC0]';

        return `
          <tr class="hover:bg-[#1A1A1A] transition-colors" data-id="${rec.id}">
            <td class="py-3.5 px-4 font-mono text-[#7A756D]">${idx + 1}</td>
            <td class="py-3.5 px-4 font-semibold text-[#F5F2EA]">${name}</td>
            <td class="py-3.5 px-4 text-[#A7A29A] font-mono">${phone}</td>
            <td class="py-3.5 px-4 text-[#C9B27C] font-semibold">${formattedDate}</td>
            <td class="py-3.5 px-4 font-mono text-[#F5F2EA] font-semibold">${formattedTime}</td>
            <td class="py-3.5 px-4">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold border ${badgeStyle}">
                <span class="w-1.5 h-1.5 rounded-full ${dotColor}"></span>
                ${methodLabel}
              </span>
            </td>
            <td class="py-3.5 px-4 text-right">
              <button
                type="button"
                data-delete-id="${rec.id}"
                data-delete-name="${name}"
                data-delete-date="${formattedDate}"
                class="px-2.5 py-1 rounded-lg bg-[#241515] hover:bg-[#3D1E1E] text-[#E53E3E] text-xs font-['Oswald'] uppercase font-semibold transition-colors cursor-pointer"
                title="Delete erroneous record"
              >
                Delete
              </button>
            </td>
          </tr>
        `;
      })
      .join('');

    // Attach delete listeners
    tbody.querySelectorAll('[data-delete-id]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLElement;
        const id = target.getAttribute('data-delete-id');
        const name = target.getAttribute('data-delete-name');
        const date = target.getAttribute('data-delete-date');
        if (!id) return;

        if (confirm(`Are you sure you want to delete check-in record for ${name} on ${date}?`)) {
          const sb = getSupabase();
          const { error } = await sb.from('attendance').delete().eq('id', id);
          if (error) {
            alert(`Failed to delete record: ${error.message}`);
          } else {
            allAttendance = allAttendance.filter((a) => a.id !== id);
            updateKPICounters();
            renderTable();
          }
        }
      });
    });
  }

  // Filter Listeners
  searchInput?.addEventListener('input', renderTable);

  datePicker?.addEventListener('change', () => {
    selectedDateFilter = datePicker.value;
    renderTable();
  });

  clearDateBtn?.addEventListener('click', () => {
    selectedDateFilter = '';
    if (datePicker) datePicker.value = '';
    renderTable();
  });

  // Manual Modal Handlers
  function openManualModal() {
    manualModal?.classList.remove('hidden');
    manualModal?.classList.add('flex');
    document.body.style.overflow = 'hidden';

    // Set today and current time as defaults
    const now = new Date();
    if (manualDateInput) manualDateInput.value = now.toISOString().substring(0, 10);
    if (manualTimeInput) {
      const hours = String(now.getHours()).padStart(2, '0');
      const mins = String(now.getMinutes()).padStart(2, '0');
      manualTimeInput.value = `${hours}:${mins}`;
    }
  }

  function closeManualModal() {
    manualModal?.classList.add('hidden');
    manualModal?.classList.remove('flex');
    document.body.style.overflow = '';
  }

  openManualBtn?.addEventListener('click', openManualModal);
  closeManualBtn?.addEventListener('click', closeManualModal);
  cancelManualBtn?.addEventListener('click', closeManualModal);
  manualModal?.addEventListener('click', (e) => {
    if (e.target === manualModal) closeManualModal();
  });

  manualForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const memberId = memberSelect?.value;
    const checkInDate = manualDateInput?.value;
    const time = manualTimeInput?.value;

    if (!memberId || !checkInDate || !time) {
      alert('Please fill out all required fields.');
      return;
    }

    const sb = getSupabase();

    // 1. HARD BLOCK: Check duplicate check-in for the same member on this date (no override)
    const { data: existing } = await sb
      .from('attendance')
      .select('id')
      .eq('member_id', memberId)
      .eq('check_in_date', checkInDate)
      .maybeSingle();

    if (existing) {
      alert(`DUPLICATE BLOCKED: This member has already checked in on ${checkInDate}. Duplicate attendance is not permitted.`);
      return;
    }

    // 2. ACTIVE MEMBERSHIP VERIFICATION: start_date <= checkInDate <= end_date AND status = 'active'
    const { data: activeMembership } = await sb
      .from('memberships')
      .select('id, start_date, end_date, status')
      .eq('member_id', memberId)
      .eq('status', 'active')
      .lte('start_date', checkInDate)
      .gte('end_date', checkInDate)
      .maybeSingle();

    if (!activeMembership) {
      alert(`MEMBERSHIP INACTIVE: Member does not have an active membership covering ${checkInDate}. Please assign or renew their membership plan first.`);
      return;
    }

    // 3. TIMEZONE-AWARE TIMESTAMP: Explicit India Standard Time (+05:30) offset
    const localCheckInTimestamp = `${checkInDate}T${time}:00+05:30`;

    // 4. EXPLICIT INSERT: check_in_method = 'manual'
    const { data, error } = await sb
      .from('attendance')
      .insert({
        member_id: memberId,
        check_in_date: checkInDate,
        check_in_time: localCheckInTimestamp,
        check_in_method: 'manual',
      })
      .select('*, profiles(*)')
      .single();

    if (error) {
      // Graceful catch for PostgreSQL unique index (23505) in concurrent race condition
      if (error.code === '23505' || error.message?.includes('attendance_one_checkin_per_member_per_day')) {
        alert(`DUPLICATE BLOCKED: This member has already checked in on ${checkInDate}.`);
      } else {
        alert(`Error recording attendance: ${error.message}`);
      }
      return;
    }

    if (data) {
      allAttendance.unshift(data as any);
      updateKPICounters();
      closeManualModal();
      renderTable();
      alert('Manual check-in recorded successfully.');
    }
  });

  // Initial load
  loadData();
</script>
