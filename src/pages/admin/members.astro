---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Members Directory | Admin Console" activeNav="members">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[#242424]">
      <div>
        <span class="text-xs uppercase font-['Oswald'] tracking-widest text-[#C9B27C] font-semibold">
          MEMBERSHIP MANAGEMENT
        </span>
        <h1 class="font-['Oswald'] text-3xl font-black text-[#F5F2EA] uppercase tracking-wide mt-1">
          MEMBER DIRECTORY
        </h1>
        <p class="text-xs sm:text-sm text-[#A7A29A] mt-1">
          Search, view subscriptions, assign plans, and renew memberships.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <span id="total-members-badge" class="px-3.5 py-1.5 rounded-xl bg-[#141414] border border-[#2E2E2E] text-xs font-mono text-[#C9B27C]">
          0 Members
        </span>
      </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="p-4 rounded-2xl bg-[#141414] border border-[#242424] flex flex-col md:flex-row items-center gap-4">
      <div class="relative flex-1 w-full">
        <input
          type="text"
          id="member-search-input"
          placeholder="Search by name, phone (+91...), or ID..."
          class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-[#0A0A0A] border border-[#2E2E2E] text-xs sm:text-sm text-[#F5F2EA] placeholder-[#555555] focus:border-[#C9B27C] focus:outline-none"
        />
        <svg class="w-4 h-4 text-[#7A756D] absolute left-3.5 top-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <!-- Filter Tabs -->
      <div class="flex items-center gap-1.5 w-full md:w-auto overflow-x-auto no-scrollbar">
        <button
          type="button"
          data-filter="all"
          class="filter-btn px-3 py-1.5 rounded-lg text-xs font-['Oswald'] uppercase tracking-wider font-semibold bg-[#C9B27C] text-[#080808]"
        >
          All
        </button>
        <button
          type="button"
          data-filter="active"
          class="filter-btn px-3 py-1.5 rounded-lg text-xs font-['Oswald'] uppercase tracking-wider font-semibold bg-[#1C1C1C] text-[#A7A29A] hover:text-[#F5F2EA]"
        >
          Active
        </button>
        <button
          type="button"
          data-filter="expiring"
          class="filter-btn px-3 py-1.5 rounded-lg text-xs font-['Oswald'] uppercase tracking-wider font-semibold bg-[#1C1C1C] text-[#A7A29A] hover:text-[#F5F2EA]"
        >
          Expiring Soon
        </button>
        <button
          type="button"
          data-filter="expired"
          class="filter-btn px-3 py-1.5 rounded-lg text-xs font-['Oswald'] uppercase tracking-wider font-semibold bg-[#1C1C1C] text-[#A7A29A] hover:text-[#F5F2EA]"
        >
          Expired
        </button>
      </div>
    </div>

    <!-- Members Table -->
    <div class="bg-[#141414] rounded-3xl border border-[#242424] overflow-hidden shadow-xl">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead>
            <tr class="text-[#7A756D] border-b border-[#242424] bg-[#111111] font-['Oswald'] uppercase tracking-wider text-xs">
              <th class="py-3.5 px-4">Member Name</th>
              <th class="py-3.5 px-4">Phone</th>
              <th class="py-3.5 px-4">Current Plan</th>
              <th class="py-3.5 px-4">End Date</th>
              <th class="py-3.5 px-4">Status</th>
              <th class="py-3.5 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="members-table-tbody" class="divide-y divide-[#1C1C1C]">
            <tr>
              <td colspan="6" class="py-12 text-center text-[#7A756D] italic">
                Loading members from database...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ASSIGN / RENEW MEMBERSHIP MODAL -->
  <div
    id="membership-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
  >
    <div class="w-full max-w-lg bg-[#141414] border border-[#2E2E2E] rounded-3xl p-6 sm:p-8 shadow-2xl space-y-6">
      <div class="flex items-center justify-between pb-4 border-b border-[#242424]">
        <div>
          <span class="text-[10px] font-['Oswald'] uppercase tracking-widest text-[#C9B27C] font-semibold">
            MEMBERSHIP PLAN
          </span>
          <h3 class="font-['Oswald'] text-2xl font-bold text-[#F5F2EA] uppercase mt-0.5">
            Assign / Renew Plan
          </h3>
        </div>
        <button type="button" id="close-plan-modal-btn" class="p-2 rounded-xl text-[#A7A29A] hover:text-[#F5F2EA]">
          ✕
        </button>
      </div>

      <form id="membership-form" class="space-y-4">
        <input type="hidden" id="modal-member-user-id" />

        <div>
          <label class="block text-xs font-['Oswald'] uppercase tracking-wider text-[#A7A29A] mb-1 font-semibold">
            Member
          </label>
          <input
            type="text"
            id="modal-member-name"
            disabled
            class="w-full px-3.5 py-2.5 rounded-xl bg-[#0A0A0A] border border-[#242424] text-xs text-[#F5F2EA] opacity-80"
          />
        </div>

        <div>
          <label for="modal-plan-select" class="block text-xs font-['Oswald'] uppercase tracking-wider text-[#F5F2EA] mb-1 font-semibold">
            Select Plan
          </label>
          <select
            id="modal-plan-select"
            required
            class="w-full px-3.5 py-2.5 rounded-xl bg-[#0A0A0A] border border-[#2E2E2E] text-xs text-[#F5F2EA] focus:border-[#C9B27C] focus:outline-none"
          >
            <option value="">Choose Membership Plan</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="modal-start-date" class="block text-xs font-['Oswald'] uppercase tracking-wider text-[#F5F2EA] mb-1 font-semibold">
              Membership Start Date
            </label>
            <input
              type="date"
              id="modal-start-date"
              required
              class="w-full px-3.5 py-2.5 rounded-xl bg-[#0A0A0A] border border-[#2E2E2E] text-xs text-[#F5F2EA] focus:border-[#C9B27C] focus:outline-none"
            />
          </div>

          <div>
            <label for="modal-end-date" class="block text-xs font-['Oswald'] uppercase tracking-wider text-[#F5F2EA] mb-1 font-semibold">
              Membership End Date
            </label>
            <input
              type="date"
              id="modal-end-date"
              required
              class="w-full px-3.5 py-2.5 rounded-xl bg-[#0A0A0A] border border-[#2E2E2E] text-xs text-[#F5F2EA] focus:border-[#C9B27C] focus:outline-none"
            />
          </div>
        </div>

        <p class="text-[11px] text-[#7A756D] leading-relaxed">
          Start date and payment date are independent. Setting dates activates the member's QR attendance scanner immediately.
        </p>

        <div class="pt-4 flex items-center justify-end gap-3">
          <button
            type="button"
            id="cancel-plan-modal-btn"
            class="px-4 py-2.5 rounded-xl bg-[#1E1E1E] text-xs text-[#A7A29A] hover:text-[#F5F2EA]"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="save-plan-btn"
            class="px-6 py-2.5 rounded-xl bg-[#C9B27C] text-[#080808] font-['Oswald'] text-xs uppercase font-bold tracking-wider hover:bg-[#D8C28E] cursor-pointer"
          >
            SAVE MEMBERSHIP
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- EDIT MEMBER PROFILE MODAL -->
  <div
    id="edit-profile-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
  >
    <div class="w-full max-w-md bg-[#141414] border border-[#2E2E2E] rounded-3xl p-6 sm:p-8 shadow-2xl space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-[#242424]">
        <h3 class="font-['Oswald'] text-xl font-bold text-[#F5F2EA] uppercase">
          Edit Member Profile
        </h3>
        <button type="button" id="close-edit-modal-btn" class="p-2 rounded-xl text-[#A7A29A] hover:text-[#F5F2EA]">
          ✕
        </button>
      </div>

      <form id="edit-profile-form" class="space-y-4">
        <input type="hidden" id="edit-user-id" />

        <div>
          <label for="edit-full-name" class="block text-xs font-['Oswald'] uppercase tracking-wider text-[#F5F2EA] mb-1 font-semibold">
            Full Name
          </label>
          <input
            type="text"
            id="edit-full-name"
            required
            placeholder="Member's full name"
            class="w-full px-3.5 py-2.5 rounded-xl bg-[#0A0A0A] border border-[#2E2E2E] text-xs text-[#F5F2EA] focus:border-[#C9B27C] focus:outline-none"
          />
        </div>

        <div>
          <label for="edit-phone" class="block text-xs font-['Oswald'] uppercase tracking-wider text-[#F5F2EA] mb-1 font-semibold">
            Phone Number
          </label>
          <input
            type="tel"
            id="edit-phone"
            required
            placeholder="+91..."
            class="w-full px-3.5 py-2.5 rounded-xl bg-[#0A0A0A] border border-[#2E2E2E] text-xs text-[#F5F2EA] focus:border-[#C9B27C] focus:outline-none"
          />
        </div>

        <div class="pt-3 flex items-center justify-end gap-3">
          <button
            type="button"
            id="cancel-edit-btn"
            class="px-4 py-2 rounded-xl bg-[#1E1E1E] text-xs text-[#A7A29A]"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="px-6 py-2 rounded-xl bg-[#C9B27C] text-[#080808] font-['Oswald'] text-xs uppercase font-bold tracking-wider hover:bg-[#D8C28E]"
          >
            Update Profile
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  import { getSupabase, formatDate, getMembershipDisplayStatus, formatCurrency } from '../../lib/supabase';

  let allMembers: any[] = [];
  let allPlans: any[] = [];
  let currentFilter = 'all';

  async function loadMembers() {
    const sb = getSupabase();

    // 1. Fetch plans
    const { data: plans } = await sb.from('membership_plans').select('*');
    allPlans = plans || [];
    populatePlanSelect(allPlans);

    // 2. Fetch profiles with role === 'member'
    const { data: profiles, error } = await sb
      .from('profiles')
      .select('*')
      .eq('role', 'member')
      .order('created_at', { ascending: false });

    // 3. Fetch all memberships
    const { data: memberships } = await sb
      .from('memberships')
      .select('*, membership_plans(*)')
      .order('end_date', { ascending: false });

    const mList = memberships || [];

    allMembers = (profiles || []).map((p) => {
      // Find latest membership for this user
      const userM = mList.find((m) => m.member_id === p.id);
      const statusInfo = userM ? getMembershipDisplayStatus(userM.end_date, userM.status) : null;
      return {
        ...p,
        activeMembership: userM || null,
        statusInfo,
      };
    });

    renderTable();
  }

  function populatePlanSelect(plans: any[]) {
    const sel = document.getElementById('modal-plan-select') as HTMLSelectElement | null;
    if (!sel) return;
    sel.innerHTML = '<option value="">Choose Membership Plan</option>' + plans.map((pl) => `
      <option value="${pl.id}" data-duration="${pl.duration}">${pl.name} — ${formatCurrency(pl.price)} (${pl.duration})</option>
    `).join('');
  }

  function renderTable() {
    const tbody = document.getElementById('members-table-tbody');
    const badge = document.getElementById('total-members-badge');
    const searchVal = (document.getElementById('member-search-input') as HTMLInputElement | null)?.value.toLowerCase() || '';

    if (badge) badge.textContent = `${allMembers.length} Members`;

    const filtered = allMembers.filter((m) => {
      const matchSearch = 
        (m.full_name || '').toLowerCase().includes(searchVal) ||
        (m.phone || '').toLowerCase().includes(searchVal) ||
        m.id.toLowerCase().includes(searchVal);

      if (!matchSearch) return false;

      if (currentFilter === 'active') return m.statusInfo?.label === 'Active';
      if (currentFilter === 'expiring') return m.statusInfo?.label === 'Expiring Soon';
      if (currentFilter === 'expired') return !m.statusInfo || m.statusInfo?.label === 'Expired';
      return true;
    });

    if (!tbody) return;

    if (filtered.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="6" class="py-12 text-center text-[#7A756D] italic">
            No matching members found.
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = filtered.map((m) => {
      const planName = m.activeMembership?.membership_plans?.name || '<span class="text-[#7A756D]">No Plan</span>';
      const endDate = m.activeMembership ? formatDate(m.activeMembership.end_date) : '—';
      const statusBadge = m.statusInfo 
        ? `<span class="px-2.5 py-0.5 rounded-full border text-[11px] font-['Oswald'] uppercase font-bold tracking-wider ${m.statusInfo.badgeClass}">${m.statusInfo.label}</span>`
        : `<span class="px-2.5 py-0.5 rounded-full border text-[11px] font-['Oswald'] uppercase font-bold tracking-wider bg-[#E53E3E]/10 text-[#E53E3E] border-[#E53E3E]/30">No Active Plan</span>`;

      return `
        <tr class="hover:bg-[#1A1A1A]/50 transition-colors">
          <td class="py-3.5 px-4 font-semibold text-[#F5F2EA]">
            ${m.full_name || 'Member'}
            <div class="text-[10px] text-[#7A756D] font-mono">${m.id.substring(0, 8)}</div>
          </td>
          <td class="py-3.5 px-4 font-mono text-xs text-[#A7A29A]">${m.phone || '—'}</td>
          <td class="py-3.5 px-4 text-xs">${planName}</td>
          <td class="py-3.5 px-4 text-xs font-medium text-[#F5F2EA]">${endDate}</td>
          <td class="py-3.5 px-4">${statusBadge}</td>
          <td class="py-3.5 px-4 text-right">
            <div class="flex items-center justify-end gap-2">
              <button
                type="button"
                data-assign-plan="${m.id}"
                data-name="${m.full_name || m.phone || 'Member'}"
                class="px-2.5 py-1.5 rounded-lg bg-[#1F1F1F] hover:bg-[#C9B27C] hover:text-[#080808] text-xs font-semibold text-[#C9B27C] transition-colors cursor-pointer"
              >
                Assign / Renew
              </button>
              <button
                type="button"
                data-edit-profile="${m.id}"
                data-name="${m.full_name || ''}"
                data-phone="${m.phone || ''}"
                class="p-1.5 rounded-lg bg-[#1F1F1F] hover:bg-[#2A2A2A] text-xs text-[#A7A29A] hover:text-[#F5F2EA] transition-colors cursor-pointer"
                title="Edit member details"
              >
                ✎
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join('');

    attachRowListeners();
  }

  function attachRowListeners() {
    // Assign / Renew Plan modal
    document.querySelectorAll('[data-assign-plan]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const userId = btn.getAttribute('data-assign-plan') || '';
        const name = btn.getAttribute('data-name') || '';
        openPlanModal(userId, name);
      });
    });

    // Edit profile modal
    document.querySelectorAll('[data-edit-profile]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const userId = btn.getAttribute('data-edit-profile') || '';
        const name = btn.getAttribute('data-name') || '';
        const phone = btn.getAttribute('data-phone') || '';
        openEditModal(userId, name, phone);
      });
    });
  }

  // Filter Buttons
  document.querySelectorAll('.filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach((b) => {
        b.className = "filter-btn px-3 py-1.5 rounded-lg text-xs font-['Oswald'] uppercase tracking-wider font-semibold bg-[#1C1C1C] text-[#A7A29A] hover:text-[#F5F2EA]";
      });
      btn.className = "filter-btn px-3 py-1.5 rounded-lg text-xs font-['Oswald'] uppercase tracking-wider font-semibold bg-[#C9B27C] text-[#080808]";
      currentFilter = btn.getAttribute('data-filter') || 'all';
      renderTable();
    });
  });

  // Search input
  document.getElementById('member-search-input')?.addEventListener('input', renderTable);

  // Plan Modal Logic
  const planModal = document.getElementById('membership-modal');
  const closePlanBtn = document.getElementById('close-plan-modal-btn');
  const cancelPlanBtn = document.getElementById('cancel-plan-modal-btn');
  const planForm = document.getElementById('membership-form') as HTMLFormElement | null;
  const planUserId = document.getElementById('modal-member-user-id') as HTMLInputElement | null;
  const planMemberName = document.getElementById('modal-member-name') as HTMLInputElement | null;
  const planSelect = document.getElementById('modal-plan-select') as HTMLSelectElement | null;
  const startDateInput = document.getElementById('modal-start-date') as HTMLInputElement | null;
  const endDateInput = document.getElementById('modal-end-date') as HTMLInputElement | null;

  function openPlanModal(userId: string, name: string) {
    if (planUserId) planUserId.value = userId;
    if (planMemberName) planMemberName.value = name;
    
    // Default start date = today
    const today = new Date().toISOString().substring(0, 10);
    if (startDateInput) startDateInput.value = today;

    // Default 1 month ahead
    const nextMonth = new Date();
    nextMonth.setMonth(nextMonth.getMonth() + 1);
    if (endDateInput) endDateInput.value = nextMonth.toISOString().substring(0, 10);

    planModal?.classList.remove('hidden');
    planModal?.classList.add('flex');
  }

  function closePlanModal() {
    planModal?.classList.add('hidden');
    planModal?.classList.remove('flex');
  }

  closePlanBtn?.addEventListener('click', closePlanModal);
  cancelPlanBtn?.addEventListener('click', closePlanModal);

  // Auto-calculate end date when plan selected
  planSelect?.addEventListener('change', () => {
    const selectedOption = planSelect.options[planSelect.selectedIndex];
    const duration = selectedOption.getAttribute('data-duration') || '1 month';
    const startVal = startDateInput?.value ? new Date(startDateInput.value) : new Date();

    let monthsToAdd = 1;
    if (duration.includes('3')) monthsToAdd = 3;
    else if (duration.includes('6')) monthsToAdd = 6;
    else if (duration.includes('12')) monthsToAdd = 12;

    const end = new Date(startVal);
    end.setMonth(end.getMonth() + monthsToAdd);
    if (endDateInput) endDateInput.value = end.toISOString().substring(0, 10);
  });

  planForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const userId = planUserId?.value;
    const planId = planSelect?.value;
    const startDate = startDateInput?.value;
    const endDate = endDateInput?.value;

    if (!userId || !planId || !startDate || !endDate) {
      alert('Please complete all plan fields.');
      return;
    }

    const sb = getSupabase();
    const saveBtn = document.getElementById('save-plan-btn') as HTMLButtonElement | null;
    if (saveBtn) saveBtn.disabled = true;

    // Insert or update membership record
    const { error } = await sb.from('memberships').insert({
      member_id: userId,
      plan_id: planId,
      start_date: startDate,
      end_date: endDate,
      status: 'active',
    });

    if (saveBtn) saveBtn.disabled = false;

    if (error) {
      alert(`Error assigning plan: ${error.message}`);
      return;
    }

    closePlanModal();
    await loadMembers();
  });

  // Edit Profile Modal Logic
  const editModal = document.getElementById('edit-profile-modal');
  const closeEditBtn = document.getElementById('close-edit-modal-btn');
  const cancelEditBtn = document.getElementById('cancel-edit-btn');
  const editForm = document.getElementById('edit-profile-form') as HTMLFormElement | null;
  const editUserId = document.getElementById('edit-user-id') as HTMLInputElement | null;
  const editName = document.getElementById('edit-full-name') as HTMLInputElement | null;
  const editPhone = document.getElementById('edit-phone') as HTMLInputElement | null;

  function openEditModal(userId: string, name: string, phone: string) {
    if (editUserId) editUserId.value = userId;
    if (editName) editName.value = name;
    if (editPhone) editPhone.value = phone;
    editModal?.classList.remove('hidden');
    editModal?.classList.add('flex');
  }

  function closeEditModal() {
    editModal?.classList.add('hidden');
    editModal?.classList.remove('flex');
  }

  closeEditBtn?.addEventListener('click', closeEditModal);
  cancelEditBtn?.addEventListener('click', closeEditModal);

  editForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const userId = editUserId?.value;
    const name = editName?.value.trim();
    const phone = editPhone?.value.trim();

    if (!userId || !name || !phone) return;

    const sb = getSupabase();
    const { error } = await sb.from('profiles').update({
      full_name: name,
      phone: phone,
      updated_at: new Date().toISOString(),
    }).eq('id', userId);

    if (error) {
      alert(`Error updating profile: ${error.message}`);
      return;
    }

    closeEditModal();
    await loadMembers();
  });

  loadMembers();
</script>
